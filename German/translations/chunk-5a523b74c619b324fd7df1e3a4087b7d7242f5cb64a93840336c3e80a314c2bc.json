{
  "gmd_path": "ui\\00_message\\quest\\q50400007.gmd",
  "arc_path": "\\quest\\q50400007.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_jp",
      "source_jp": "竜は理から生まれた――",
      "source_en": "",
      "text": "Die Drachen sind aus der Ordnung hervorgegangen …"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_jp",
      "source_jp": "竜は理の守護者――",
      "source_en": "",
      "text": "Die Drachen hüten die Ordnung …"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_jp",
      "source_jp": "わたしは知ったのだ――",
      "source_en": "",
      "text": "Das habe ich erkannt …"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_jp",
      "source_jp": "理はわたしを縛りつける――",
      "source_en": "",
      "text": "Die Ordnung legt mich in Fesseln …"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_jp",
      "source_jp": "理はこの狭き世界にわたしを閉じ込める",
      "source_en": "",
      "text": "Die Ordnung hält mich in dieser engen Welt gefangen."
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_jp",
      "source_jp": "理の外とは如何なるものか――",
      "source_en": "",
      "text": "Was liegt jenseits der Ordnung …?"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_jp",
      "source_jp": "わたしはその理の外を見たい――",
      "source_en": "",
      "text": "Ich will sehen, was außerhalb der Ordnung liegt …"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_jp",
      "source_jp": "理の壁を壊してやろう",
      "source_en": "",
      "text": "Ich werde die Mauern der Ordnung einreißen."
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_jp",
      "source_jp": "もはや何人もわたしを止めることは出来ぬ",
      "source_en": "",
      "text": "Niemand kann mich mehr aufhalten."
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_jp",
      "source_jp": "この世界を壊して穴をあけるのだ――",
      "source_en": "",
      "text": "Ich werde diese Welt zerschlagen und einen Durchbruch schaffen …"
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_jp",
      "source_jp": "もうすぐ終わる――",
      "source_en": "",
      "text": "Bald ist es vorbei …"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_jp",
      "source_jp": "おまえたちを倒し――",
      "source_en": "",
      "text": "Ich werde euch bezwingen …"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_jp",
      "source_jp": "わたしは理の外を見よう――",
      "source_en": "",
      "text": "… und sehen, was jenseits der Ordnung liegt …"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
