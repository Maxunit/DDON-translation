{
  "gmd_path": "ui\\00_message\\quest\\q19000004.gmd",
  "arc_path": "\\quest\\q19000004.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_jp",
      "source_jp": "ピレモスへ食料を運ぶわ\r\n手伝ってくれないかしら",
      "source_en": "",
      "text": "Ich bringe Vorräte nach Piremoth.\r\nKannst du mir dabei helfen?"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_jp",
      "source_jp": "手伝ってくれるのね",
      "source_en": "",
      "text": "Du hilfst mir? Danke."
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_jp",
      "source_jp": "準備を整えたら\r\nすぐに向かいましょう",
      "source_en": "",
      "text": "Sobald du bereit bist,\r\nbrechen wir auf."
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_jp",
      "source_jp": "持っていく食料を選んだら\r\nピレモスへ向かいましょう",
      "source_en": "",
      "text": "Such aus, welche Vorräte wir mitnehmen.\r\nDann brechen wir nach Piremoth auf."
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_jp",
      "source_jp": "食料Aを運ぶ",
      "source_en": "",
      "text": "Vorräte A mitnehmen"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_jp",
      "source_jp": "食料Bを運ぶ",
      "source_en": "",
      "text": "Vorräte B mitnehmen"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_jp",
      "source_jp": "もう少し準備する",
      "source_en": "",
      "text": "Noch etwas vorbereiten"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_jp",
      "source_jp": "食料Aを持っていくわ",
      "source_en": "",
      "text": "Ich nehme Vorräte A mit."
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_jp",
      "source_jp": "砦の外で待ち合わせましょう",
      "source_en": "",
      "text": "Wir treffen uns vor der Festung."
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_jp",
      "source_jp": "食料Bを持っていくわ",
      "source_en": "",
      "text": "Ich nehme Vorräte B mit."
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_jp",
      "source_jp": "砦の外で待ち合わせましょう",
      "source_en": "",
      "text": "Wir treffen uns vor der Festung."
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_jp",
      "source_jp": "ピレモスへ向かいましょう",
      "source_en": "",
      "text": "Auf nach Piremoth."
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_jp",
      "source_jp": "どの道を通ったらいいかしら",
      "source_en": "",
      "text": "Welchen Weg sollen wir nehmen?"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_jp",
      "source_jp": "野原へ向かう",
      "source_en": "",
      "text": "Über die Wiese gehen"
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_jp",
      "source_jp": "街道へ向かう",
      "source_en": "",
      "text": "Die Landstraße nehmen"
    },
    {
      "key": "",
      "read_index": "15",
      "tag_source": "source_jp",
      "source_jp": "わかったわ",
      "source_en": "",
      "text": "Alles klar."
    },
    {
      "key": "",
      "read_index": "16",
      "tag_source": "source_jp",
      "source_jp": "野原へ向かいましょう",
      "source_en": "",
      "text": "Gehen wir über die Wiese."
    },
    {
      "key": "",
      "read_index": "17",
      "tag_source": "source_jp",
      "source_jp": "わかったわ",
      "source_en": "",
      "text": "Alles klar."
    },
    {
      "key": "",
      "read_index": "18",
      "tag_source": "source_jp",
      "source_jp": "街道へ向かいましょう",
      "source_en": "",
      "text": "Nehmen wir die Landstraße."
    },
    {
      "key": "",
      "read_index": "19",
      "tag_source": "source_jp",
      "source_jp": "先へ進みましょう",
      "source_en": "",
      "text": "Gehen wir weiter."
    },
    {
      "key": "",
      "read_index": "20",
      "tag_source": "source_jp",
      "source_jp": "どの道を通ったらいいかしら",
      "source_en": "",
      "text": "Welchen Weg sollen wir nehmen?"
    },
    {
      "key": "",
      "read_index": "21",
      "tag_source": "source_jp",
      "source_jp": "丘へ向かう",
      "source_en": "",
      "text": "Zum Hügel gehen"
    },
    {
      "key": "",
      "read_index": "22",
      "tag_source": "source_jp",
      "source_jp": "関所へ向かう",
      "source_en": "",
      "text": "Zur Wegsperre gehen"
    },
    {
      "key": "",
      "read_index": "23",
      "tag_source": "source_jp",
      "source_jp": "わかったわ",
      "source_en": "",
      "text": "Alles klar."
    },
    {
      "key": "",
      "read_index": "24",
      "tag_source": "source_jp",
      "source_jp": "丘へ向かいましょう",
      "source_en": "",
      "text": "Gehen wir zum Hügel."
    },
    {
      "key": "",
      "read_index": "25",
      "tag_source": "source_jp",
      "source_jp": "ここからでは関所へ向かうのは\r\n難しそうね",
      "source_en": "",
      "text": "Von hier aus kommen wir wohl\r\nnicht so leicht zur Wegsperre."
    },
    {
      "key": "",
      "read_index": "26",
      "tag_source": "source_jp",
      "source_jp": "先へ進みましょう",
      "source_en": "",
      "text": "Gehen wir weiter."
    },
    {
      "key": "",
      "read_index": "27",
      "tag_source": "source_jp",
      "source_jp": "どの道を通ったらいいかしら",
      "source_en": "",
      "text": "Welchen Weg sollen wir nehmen?"
    },
    {
      "key": "",
      "read_index": "28",
      "tag_source": "source_jp",
      "source_jp": "川辺へ向かう",
      "source_en": "",
      "text": "Zum Flussufer gehen"
    },
    {
      "key": "",
      "read_index": "29",
      "tag_source": "source_jp",
      "source_jp": "村はずれへ向かう",
      "source_en": "",
      "text": "Zum Dorfrand gehen"
    },
    {
      "key": "",
      "read_index": "30",
      "tag_source": "source_jp",
      "source_jp": "わかったわ",
      "source_en": "",
      "text": "Alles klar."
    },
    {
      "key": "",
      "read_index": "31",
      "tag_source": "source_jp",
      "source_jp": "川辺へ向かいましょう",
      "source_en": "",
      "text": "Gehen wir zum Flussufer."
    },
    {
      "key": "",
      "read_index": "32",
      "tag_source": "source_jp",
      "source_jp": "わかったわ",
      "source_en": "",
      "text": "Alles klar."
    },
    {
      "key": "",
      "read_index": "33",
      "tag_source": "source_jp",
      "source_jp": "村はずれへ向かいましょう",
      "source_en": "",
      "text": "Gehen wir zum Dorfrand."
    },
    {
      "key": "",
      "read_index": "34",
      "tag_source": "source_jp",
      "source_jp": "さあ、ピレモスへ向かいましょう",
      "source_en": "",
      "text": "Na los, auf nach Piremoth!"
    },
    {
      "key": "",
      "read_index": "35",
      "tag_source": "source_jp",
      "source_jp": "食料を持ってきてくれたのか、助かる",
      "source_en": "",
      "text": "Ihr habt Vorräte mitgebracht? Das hilft uns sehr."
    },
    {
      "key": "",
      "read_index": "36",
      "tag_source": "source_jp",
      "source_jp": "さあ、食堂へ戻りましょう",
      "source_en": "",
      "text": "Gehen wir zurück in den Speisesaal."
    },
    {
      "key": "",
      "read_index": "37",
      "tag_source": "source_jp",
      "source_jp": "今日はありがとう、また手伝ってね",
      "source_en": "",
      "text": "Danke für heute. Hilfst du mir beim nächsten Mal wieder?"
    },
    {
      "key": "",
      "read_index": "38",
      "tag_source": "source_jp",
      "source_jp": "この辺りを探索しましょう",
      "source_en": "",
      "text": "Sehen wir uns hier in der Gegend um."
    },
    {
      "key": "",
      "read_index": "39",
      "tag_source": "source_jp",
      "source_jp": "ここに何かあるわ",
      "source_en": "",
      "text": "Hier liegt etwas."
    },
    {
      "key": "",
      "read_index": "40",
      "tag_source": "source_jp",
      "source_jp": "これも食料として持っていきましょう",
      "source_en": "",
      "text": "Das nehmen wir auch als Proviant mit."
    },
    {
      "key": "",
      "read_index": "41",
      "tag_source": "source_jp",
      "source_jp": "何かないかしら――",
      "source_en": "",
      "text": "Ob hier noch etwas liegt …"
    },
    {
      "key": "",
      "read_index": "42",
      "tag_source": "source_jp",
      "source_jp": "準備を整えたら\r\nピレモスへ向かいましょう",
      "source_en": "",
      "text": "Sobald du bereit bist,\r\nbrechen wir nach Piremoth auf."
    },
    {
      "key": "",
      "read_index": "43",
      "tag_source": "source_jp",
      "source_jp": "先へ進みましょう",
      "source_en": "",
      "text": "Gehen wir weiter."
    },
    {
      "key": "",
      "read_index": "44",
      "tag_source": "source_jp",
      "source_jp": "どの道を通ったらいいかしら",
      "source_en": "",
      "text": "Welchen Weg sollen wir nehmen?"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
