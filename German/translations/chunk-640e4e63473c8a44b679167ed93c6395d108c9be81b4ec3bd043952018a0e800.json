  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "セシリー――",
      "source_en": "Cecily...",
      "text": "Cecily …"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "セシリーはどこだ",
      "source_en": "Where is Cecily?",
      "text": "Wo ist Cecily?"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "今一度訊こう",
      "source_en": "Let me ask again.",
      "text": "Ich frage noch einmal."
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "セシリーはどこだ――",
      "source_en": "Where is Cecily...?",
      "text": "Wo ist Cecily …?"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "そんな奴、知らねえよ！",
      "source_en": "We don't know anyone by that name!",
      "text": "So jemanden kennen wir nicht!"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "逃げ――",
      "source_en": "Run away...",
      "text": "Lauf …"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "逃げろ！",
      "source_en": "Run!",
      "text": "Lauf weg!"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "黒き鎧をまといし者よ",
      "source_en": "O wearer of the black armor.",
      "text": "Der du die schwarze Rüstung trägst!"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "ここは我が大地、レスタニア",
      "source_en": "Lestania is my domain.",
      "text": "Lestania ist mein Reich."
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "ゆめゆめ忘れるな！",
      "source_en": "Heed my warning!",
      "text": "Vergiss das niemals!"
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "ん！？",
      "source_en": "Huh!?",
      "text": "Hä?!"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "うっ――",
      "source_en": "Ugh...",
      "text": "Uff …"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
