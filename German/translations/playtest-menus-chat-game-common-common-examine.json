  "entries": [
    {
      "key": "",
      "read_index": "23",
      "source_jp": "準備完了！　進行マーカーに触れてください",
      "source_en": "Ready! Please touch the progress marker.",
      "text": "Bereit! Berühre die Markierung."
    },
    {
      "key": "",
      "read_index": "24",
      "source_jp": "準備完了！　待機してください",
      "source_en": "Ready! Please wait.",
      "text": "Bereit! Bitte warte."
    },
    {
      "key": "",
      "read_index": "25",
      "source_jp": "パーティー全員が集合するまで\r\nサークル内で待機してください",
      "source_en": "Please wait in the circle\r\nuntil the entire party is ready.",
      "text": "Warte im Kreis, bis alle da sind."
    },
    {
      "key": "",
      "read_index": "26",
      "source_jp": "リーダーが進行準備・パーティー招集を行いました",
      "source_en": "Leader has begun a progress preparation.",
      "text": "Die Gruppenleitung hat die Vorbereitung gestartet."
    },
    {
      "key": "",
      "read_index": "27",
      "source_jp": "パーティー全員が集まり、準備完了したら\r\n進行マーカーに触れてください",
      "source_en": "Gather the party if you are ready.\r\nPlease touch the progress marker.",
      "text": "Berühre die Markierung, sobald alle bereit sind."
    },
    {
      "key": "",
      "read_index": "28",
      "source_jp": "イベントを進行しますか？\r\n※パーティー要請中の場合はキャンセルされます",
      "source_en": "Are you sure you want to proceed\r\nwith the event?\r\n※ If there is a party request,\r\nit will be canceled.",
      "text": "Mit dem Ereignis fortfahren?\r\nEine laufende Gruppenanfrage\r\nwird dabei abgebrochen."
    },
    {
      "key": "",
      "read_index": "29",
      "source_jp": "準備開始（パーティー招集）",
      "source_en": "Prepare (begin gathering party)",
      "text": "Gruppe versammeln"
    },
    {
      "key": "",
      "read_index": "30",
      "source_jp": "キャンセル",
      "source_en": "Cancel",
      "text": "Abbrechen"
    },
    {
      "key": "",
      "read_index": "31",
      "source_jp": "イベント進行はリーダーのみ可能です",
      "source_en": "Only the party leader can progress the event.",
      "text": "Nur die Gruppenleitung kann fortfahren."
    },
    {
      "key": "",
      "read_index": "32",
      "source_jp": "イベント進行確認",
      "source_en": "Confirm Event Progress",
      "text": "Ereignis fortsetzen?"
    },
    {
      "key": "",
      "read_index": "33",
      "source_jp": "進行する",
