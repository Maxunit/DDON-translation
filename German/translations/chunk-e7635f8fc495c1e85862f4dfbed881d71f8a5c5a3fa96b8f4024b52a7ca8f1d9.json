  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "諸君の",
      "source_en": "All of you...",
      "text": "Ich danke euch allen,"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "グリッテン砦防衛隊への参加",
      "source_en": "Participation in the Fort Gritten Defense",
      "text": "dass ihr euch der Verteidigung"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "感謝する！",
      "source_en": "Is appreciated!",
      "text": "von Festung Gritten anschließt!"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "オーク相手に情けは無用！",
      "source_en": "No mercy for orcs!",
      "text": "Zeigt den Orks kein Erbarmen!"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "斬り、刺し、打ち捨てにして進め！",
      "source_en": "Cut, stab, and push forward!",
      "text": "Schlagt sie nieder und rückt vor!"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "覚者たちよ！",
      "source_en": "Arisen!",
      "text": "Erweckte!"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "存分に名をあげよ！",
      "source_en": "Make a name for yourself!",
      "text": "Macht euch einen Namen!"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "いざ",
      "source_en": "Now!",
      "text": "Jetzt"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "戦野へ！",
      "source_en": "To the battlefield!",
      "text": "auf ins Feld!"
    }
  ],
