{
  "gmd_path": "ui\\00_message\\event\\st0112\\ev010.gmd",
  "arc_path": "\\event\\st0112\\st0112ev010.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "セシリー、逃げて！",
      "source_en": "Cecily, run!",
      "text": "Cecily, lauf!"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "所詮、定めにはあらがえぬ！",
      "source_en": "After all, you can't go against fate!",
      "text": "Deinem Schicksal kannst du nicht entkommen!"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "レオ！？",
      "source_en": "Leo!?",
      "text": "Leo?!"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "邪魔をするか――",
      "source_en": "Are you getting in the way?",
      "text": "Du stellst dich mir in den Weg …"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "おまえの目――",
      "source_en": "Your eyes...",
      "text": "Deine Augen …"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "その輝きは、生ある世界を見つめるためにある",
      "source_en": "The brilliance exists to gaze upon the living\r\nworld.",
      "text": "Das Leuchten in deinen Augen ist dazu da,\r\ndie Welt der Lebenden zu sehen."
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "守れなくて、なんのための覚者だ！",
      "source_en": "If I can't protect, what's the point of being an\r\nArisen?",
      "text": "Was bin ich denn für ein Erweckter,\r\nwenn ich niemanden beschützen kann?!"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "もう誰も失わない！",
      "source_en": "No one will be lost anymore!",
      "text": "Ich werde niemanden mehr verlieren!"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "そのために手にした強さだ",
      "source_en": "That is the strength I have gained for that\r\npurpose.",
      "text": "Dafür habe ich mir\r\ndiese Kraft erkämpft."
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "その力、今差し出せというのなら――",
      "source_en": "If you ask me to present that power now...",
      "text": "Wenn ich sie jetzt hergeben soll …"
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "――俺が！",
      "source_en": "—Me!",
      "text": "… dann bin ich es, der sie hergibt!"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "あとの世は――",
      "source_en": "The world that follows...",
      "text": "Die Welt, die danach kommt …"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "おまえに託そう！",
      "source_en": "I will entrust it to you!",
      "text": "… vertraue ich dir an!"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "貴様――",
      "source_en": "You...",
      "text": "Du wagst es …"
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_en",
      "source_jp": "果たせぬ夢など――",
      "source_en": "There is no dream that cannot be realized!",
      "text": "Es gibt keinen Traum …"
    },
    {
      "key": "",
      "read_index": "15",
      "tag_source": "source_en",
      "source_jp": "ない！",
      "source_en": "None!",
      "text": "… der sich nicht erfüllen lässt!"
    },
    {
      "key": "",
      "read_index": "16",
      "tag_source": "source_en",
      "source_jp": "レオオオオオオ！！！",
      "source_en": "Leo!!",
      "text": "Leooo!"
    },
    {
      "key": "",
      "read_index": "17",
      "tag_source": "source_en",
      "source_jp": "はっ！",
      "source_en": "Hah!",
      "text": "Ha!"
    },
    {
      "key": "",
      "read_index": "18",
      "tag_source": "source_en",
      "source_jp": "うっ！",
      "source_en": "Ugh!",
      "text": "Uff!"
    },
    {
      "key": "",
      "read_index": "19",
      "tag_source": "source_en",
      "source_jp": "うっ！",
      "source_en": "Ugh!",
      "text": "Uh!"
    },
    {
      "key": "",
      "read_index": "20",
      "tag_source": "source_en",
      "source_jp": "うっ！",
      "source_en": "Ugh!",
      "text": "Uh!"
    },
    {
      "key": "",
      "read_index": "21",
      "tag_source": "source_en",
      "source_jp": "わっ！！",
      "source_en": "Wow!!",
      "text": "Woah!"
    },
    {
      "key": "",
      "read_index": "22",
      "tag_source": "source_en",
      "source_jp": "うっっ――",
      "source_en": "Ugh...",
      "text": "Uhh …"
    },
    {
      "key": "",
      "read_index": "23",
      "tag_source": "source_en",
      "source_jp": "づあっ！",
      "source_en": "Oof!",
      "text": "Uah!"
    },
    {
      "key": "",
      "read_index": "24",
      "tag_source": "source_en",
      "source_jp": "ぬんっ！！",
      "source_en": "Nghh!!",
      "text": "Nngh!"
    },
    {
      "key": "",
      "read_index": "25",
      "tag_source": "source_en",
      "source_jp": "ぐっっ――\r\nうぉぉぉ―― ",
      "source_en": "Guhhh...\r\nWhoaaa...",
      "text": "Uff …\r\nAaah …"
    },
    {
      "key": "",
      "read_index": "26",
      "tag_source": "source_en",
      "source_jp": "うっおおおぉぉ！！",
      "source_en": "Uwaaaaahhh!!",
      "text": "Uaaaah!"
    },
    {
      "key": "",
      "read_index": "27",
      "tag_source": "source_en",
      "source_jp": "うおおおお！",
      "source_en": "Ohhh!",
      "text": "Raaah!"
    },
    {
      "key": "",
      "read_index": "28",
      "tag_source": "source_en",
      "source_jp": "ぬぅぅん！",
      "source_en": "*Groan*!",
      "text": "Nngh!"
    },
    {
      "key": "",
      "read_index": "29",
      "tag_source": "source_en",
      "source_jp": "（力を込めた咆哮）",
      "source_en": "(Roaring with power)",
      "text": "(Kraftvolles Brüllen.)"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
