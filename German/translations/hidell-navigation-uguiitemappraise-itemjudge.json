{
  "schema_version": 1,
  "scope": "Hidell travel, quest-hint rewards, appraisal exchange and Alfred's area-master dialogue",
  "gmd_path": "ui\\00_message\\ui\\ItemJudge.gmd",
  "arc_path": "\\ui\\uGUIItemAppraise.arc",
  "entries": [
    {
      "key": "ItemJudge_000",
      "read_index": "0",
      "source_jp": "どれを鑑定しますか？",
      "source_en": "What would you like to appraise?",
      "text": "Was möchtest du begutachten lassen?"
    },
    {
      "key": "ItemJudge_001",
      "read_index": "1",
      "source_jp": "(所持数：%d)",
      "source_en": "(Have: %d)",
      "text": "(Im Besitz: %d)"
    },
    {
      "key": "ItemJudge_002",
      "read_index": "2",
      "source_jp": "鑑定しました。以下の内容でよろしいですか？\r\n　鑑定アイテム ： <VAL> × <VAL>\r\n　<COL ffdc78>鑑定結果　　 ： <VAL> × <VAL></COL>",
      "source_en": "Item appraised. Is this OK?\r\nAppraised Item: <VAL> × <VAL>\r\n<COL ffdc78>Results: <VAL> × <VAL></COL>",
      "text": "Begutachtung annehmen?\r\nGegenstand: <VAL> × <VAL>\r\n<COL ffdc78>Ergebnis: <VAL> × <VAL></COL>"
    },
    {
      "key": "ItemJudge_003",
      "read_index": "3",
      "source_jp": "以下のアイテムを獲得しました\r\n　<COL ffdc78><VAL> × <VAL></COL>",
      "source_en": "You have obtained:\r\n<COL ffdc78><VAL> × <VAL></COL>",
      "text": "Erhalten:\r\n<COL ffdc78><VAL> × <VAL></COL>"
    },
    {
      "key": "confirm_judge_random",
      "read_index": "4",
      "source_jp": "鑑定します。よろしいですか？\r\n　鑑定アイテム ： <VAL> × <VAL>\r\n　費用　　　　 ： <VAL GOLD>\r\n以下のいずれかのアイテムのようです",
      "source_en": "Appraising item. Is this OK?\r\nAppraised Item: <VAL> × <VAL>\r\nCost: <VAL GOLD>\r\nIt seems to be one of the following items.",
      "text": "Diesen Gegenstand begutachten lassen?\r\nGegenstand: <VAL> × <VAL>\r\nKosten: <VAL GOLD>\r\nDas Ergebnis steht in der Liste unten."
    },
    {
      "key": "ItemJudge_title",
      "read_index": "5",
      "source_jp": "Trade",
      "source_en": "Trade",
      "text": "Tausch"
    },
    {
      "key": "ItemJudge_title_sub",
      "read_index": "6",
      "source_jp": "鑑定交換",
      "source_en": "Appraisal Exchange",
      "text": "Begutachtung"
    },
    {
      "key": "ItemJudge_cost",
      "read_index": "7",
      "source_jp": "費用",
      "source_en": "Cost",
      "text": "Kosten"
    },
    {
      "key": "ItemJudge_need_item",
      "read_index": "8",
      "source_jp": "必要アイテム",
      "source_en": "Required items",
      "text": "Benötigte Gegenstände"
    },
    {
      "key": "ItemJudge_need_num",
      "read_index": "9",
      "source_jp": "必要数",
      "source_en": "Num",
      "text": "Anzahl"
    },
    {
      "key": "ItemJudge_appraise_list",
      "read_index": "10",
      "source_jp": "鑑定リスト",
      "source_en": "Appraisal List",
      "text": "Begutachtungsliste"
    },
    {
      "key": "ItemJudge_get_num",
      "read_index": "12",
      "source_jp": "獲得数",
      "source_en": "Num",
      "text": "Anzahl"
    },
    {
      "key": "ItemJudge_lot_item",
      "read_index": "13",
      "source_jp": "以下のアイテムが抽選されます",
      "source_en": "Following items will be drawn from",
      "text": "Mögliche Gegenstände"
    },
    {
      "key": "ItemJudge_lot_crest",
      "read_index": "14",
      "source_jp": "以下のクレストが抽選されます",
      "source_en": "Following crests will be drawn from",
      "text": "Mögliche Wappen"
    },
    {
      "key": "ItemJudge_select_storage_notice",
      "read_index": "15",
      "source_jp": "保存先を選択してください",
      "source_en": "Please select destination",
      "text": "Wähle den Ablageort."
    },
    {
      "key": "ItemJudge_period",
      "read_index": "16",
      "source_jp": "期限",
      "source_en": "Period",
      "text": "Zeitraum"
    },
    {
      "key": "ItemJudge_infinit",
      "read_index": "17",
      "source_jp": "無期限",
      "source_en": "Indefinite",
      "text": "Unbegrenzt"
    },
    {
      "key": "ItemJudge_need_list",
      "read_index": "18",
      "source_jp": "費用/必要アイテム一覧",
      "source_en": "Cost/Required Item List",
      "text": "Kosten und Material"
    },
    {
      "key": "ItemJudge_trade_list",
      "read_index": "19",
      "source_jp": "交換アイテム一覧",
      "source_en": "Exchange Item List",
      "text": "Tauschliste"
    },
    {
      "key": "ItemJudge_appraise_confirm",
      "read_index": "20",
      "source_jp": "以下を鑑定します。よろしいですか？\r\n鑑定名：<VAL>\r\n保存先：<VAL>",
      "source_en": "Do you want to appraise the following? \r\nPlease confirm.\r\nItem name: <VAL> \r\nStorage Location: <VAL>",
      "text": "Diesen Gegenstand begutachten lassen?\r\nGegenstand: <VAL>\r\nAblageort: <VAL>"
    },
    {
      "key": "ItemJudge_appraise_notice",
      "read_index": "21",
      "source_jp": "以下のアイテムを獲得しました",
      "source_en": "You have obtained the following items.",
      "text": "Du hast folgende Gegenstände erhalten."
    },
    {
      "key": "ItemJudge_limit_num_error",
      "read_index": "22",
      "source_jp": "回数制限があります。これ以上は交換できません",
      "source_en": "There is a usage limit. You cannot exchange more.",
      "text": "Du hast das Tauschlimit erreicht."
    },
    {
      "key": "ItemJudge_shortage_error",
      "read_index": "23",
      "source_jp": "費用または必要アイテムが足りません",
      "source_en": "Insufficient cost or required items.",
      "text": "Dir fehlen Gegenstände oder Zahlungsmittel."
    },
    {
      "key": "ItemJudge_storage_error",
      "read_index": "24",
      "source_jp": "アイテムが受け取れない可能性があります\r\nアイテム枠を十分に空けてください",
      "source_en": "There is a possibility you may not receive the\r\nitem. Please make sure there is enough space in\r\nyour inventory.",
      "text": "Prüfe, ob in deiner Tasche genug Platz\r\nfür die Gegenstände ist."
    },
    {
      "key": "ItemJudge_nothing_error",
      "read_index": "25",
      "source_jp": "現在、配信されていません",
      "source_en": "Currently there are no exchanges.",
      "text": "Derzeit ist kein Tausch verfügbar."
    },
    {
      "key": "ItemJudge_and_more",
      "read_index": "26",
      "source_jp": "and more...",
      "source_en": "and more...",
      "text": "und mehr ..."
    },
    {
      "key": "ItemJudge_category",
      "read_index": "27",
      "source_jp": "Category",
      "source_en": "Category",
      "text": "Kategorie"
    },
    {
      "key": "ItemJudge_woman_only",
      "read_index": "28",
      "source_jp": "[女性専用]",
      "source_en": "[Female Only]",
      "text": "[Nur weiblich]"
    },
    {
      "key": "ItemJudge_man_only",
      "read_index": "29",
      "source_jp": "[男性専用]",
      "source_en": "[Male Only]",
      "text": "[Nur männlich]"
    },
    {
      "key": "ItemJudge_select_storage_error",
      "read_index": "30",
      "source_jp": "この保存先は選択できません",
      "source_en": "I cannot select this destination.",
      "text": "Dieser Ablageort ist nicht verfügbar."
    }
  ]
