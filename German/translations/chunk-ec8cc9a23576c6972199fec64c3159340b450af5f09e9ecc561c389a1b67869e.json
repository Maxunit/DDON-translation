{
  "gmd_path": "ui\\00_message\\event\\st0418\\ev025.gmd",
  "arc_path": "\\event\\st0418\\st0418ev025.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "未来が――見えないか――",
      "source_en": "The future... Can't you see it?",
      "text": "Die Zukunft … Seht ihr sie denn nicht …?"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "竜の――世で――",
      "source_en": "In the dragon's world...",
      "text": "In einer Welt der Drachen …"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "満足か――",
      "source_en": "Are you satisfied...?",
      "text": "Seid ihr damit zufrieden …?"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "そこの――",
      "source_en": "You there...",
      "text": "Du da …"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "若き錬金の継承者よ――",
      "source_en": "You, young heir of alchemy...",
      "text": "Du junger Erbe der Alchemie …"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "わたしの遺志を――",
      "source_en": "My legacy—",
      "text": "Führe mein Werk fort …"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "僕？　僕に言ってるのかい？",
      "source_en": "Me? Are you talking to me?",
      "text": "Ich? Sprichst du mit mir?"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "ああ",
      "source_en": "Yes.",
      "text": "Ja."
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "あんたの遺志なんて知るもんか",
      "source_en": "I don't give a shit about your legacy!",
      "text": "Was kümmert mich dein Werk?"
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "あんたは――友達の仇だ\r\n僕は仇が討てて満足さ",
      "source_en": "You're— the enemy of my friend.\r\nI'm satisfied with avenging her.",
      "text": "Du hast mir eine Freundin genommen.\r\nMir genügt es, sie gerächt zu haben."
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "クラウス――",
      "source_en": "Klaus—",
      "text": "Klaus …"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "嗚呼、哀れ――",
      "source_en": "Ah, how pitiful—",
      "text": "Ach, wie erbärmlich …"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "哀れ",
      "source_en": "Pitiful...",
      "text": "Erbärmlich …"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "小さき者",
      "source_en": "Little one...",
      "text": "Du kleiner Mensch …"
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_en",
      "source_jp": "大界を",
      "source_en": "Of the grand world...",
      "text": "Von der großen Welt …"
    },
    {
      "key": "",
      "read_index": "15",
      "tag_source": "source_en",
      "source_jp": "知らず――",
      "source_en": "You know nothing...",
      "text": "… weißt du nichts."
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
