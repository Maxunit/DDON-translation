{
  "gmd_path": "ui\\00_message\\event\\st0464\\ev005.gmd",
  "arc_path": "\\event\\st0464\\st0464ev005.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "やった！",
      "source_en": "Got it!",
      "text": "Ich hab’s!"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "たわむれは、ここまでだ――",
      "source_en": "The fun is over—",
      "text": "Das Spiel ist aus …"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "まずい、逃げるぞ！",
      "source_en": "This isn't good, we should flee!",
      "text": "Das sieht gar nicht gut aus. Wir müssen weg!"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "待て！",
      "source_en": "Wait!",
      "text": "Warte!"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "行かせるか！",
      "source_en": "You're not going anywhere!",
      "text": "Du entkommst uns nicht!"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "邪魔だ！！",
      "source_en": "Out of my way!!",
      "text": "Aus dem Weg!"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "うわっ（リアクションボイス）",
      "source_en": "Ugh (reacting)",
      "text": "Uff! (keucht)"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "はっ！！（リアクションボイス）",
      "source_en": "Hah!! (reacting)",
      "text": "Ha! (ruft)"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "はっ（リアクションボイス）",
      "source_en": "Hah (reacting)",
      "text": "Ha! (ruft)"
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "貴様ァ！！",
      "source_en": "You!!",
      "text": "Du!"
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "うっ――（リアクションボイス）",
      "source_en": "Uh— (reacting)",
      "text": "Uh … (stöhnt)"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "許さん！！",
      "source_en": "You are not to be forgiven!!!",
      "text": "Das verzeihe ich dir nicht!"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "ジリアン！",
      "source_en": "Gillian！",
      "text": "Gillian!"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "早く剣を！",
      "source_en": "Quickly, the sword!",
      "text": "Schnell, das Schwert!"
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_en",
      "source_jp": "あなたたちとの時は黄金のように輝いていた",
      "source_en": "The moments with you were as bright as gold.",
      "text": "Die Zeit mit euch hat geleuchtet wie Gold."
    },
    {
      "key": "",
      "read_index": "15",
      "tag_source": "source_en",
      "source_jp": "ううん、まるで希望のように――",
      "source_en": "No, it was like hope itself—",
      "text": "Nein … sie hat mir Hoffnung gegeben …"
    },
    {
      "key": "",
      "read_index": "16",
      "tag_source": "source_en",
      "source_jp": "ネド王子をお願い！",
      "source_en": "Prince Nedo, please!",
      "text": "Bitte, passt auf Prinz Nedo auf!"
    },
    {
      "key": "",
      "read_index": "17",
      "tag_source": "source_en",
      "source_jp": "この国を――",
      "source_en": "This country...",
      "text": "Dieses Land …"
    },
    {
      "key": "",
      "read_index": "18",
      "tag_source": "source_en",
      "source_jp": "この国を助けて！",
      "source_en": "Help save this country!",
      "text": "Bitte rettet dieses Land!"
    },
    {
      "key": "",
      "read_index": "19",
      "tag_source": "source_en",
      "source_jp": "ジリアン！！",
      "source_en": "Gillian！！",
      "text": "Gillian!"
    },
    {
      "key": "",
      "read_index": "20",
      "tag_source": "source_en",
      "source_jp": "隊長――",
      "source_en": "Captain...",
      "text": "Hauptmann …"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
