{
  "gmd_path": "ui\\00_message\\event\\st0201\\ev210.gmd",
  "arc_path": "\\event\\st0201\\st0201ev210.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "っぐ！（リアクションボイス）",
      "source_en": "Ugh! (reacting)",
      "text": "Uff! (stöhnt)"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "むうん！（掛け声）",
      "source_en": "Raah! (Battle cry)",
      "text": "Haa! (Kampfruf)"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "ボオオッ！（威嚇する）",
      "source_en": "Rooaaar! (Intimidating)",
      "text": "Raaah! (brüllt drohend)"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "ッがああああーー！！（掛け声）",
      "source_en": "Gaaaahh! (Battle cry)",
      "text": "Gaaah! (Kampfruf)"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "がふッ！（リアクションボイス）",
      "source_en": "Gah! (reacting)",
      "text": "Gah! (keucht)"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "むううううんっ！",
      "source_en": "Grrrmmm!",
      "text": "Mmmh!"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "ぐぉぉぉぉ！（リアクションボイス）",
      "source_en": "Goooaahh! (reacting)",
      "text": "Gwoaah! (brüllt)"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "なに！？",
      "source_en": "What!?",
      "text": "Was?!"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "竜力が――吸い取られている！？",
      "source_en": "Is the dragon power being absorbed!?",
      "text": "Saugt er ihm die Drachenkraft aus?!"
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "はーーーっ！（リアクションボイス）",
      "source_en": "Haaah! (reacting)",
      "text": "Haaah! (ruft)"
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "ぐォォォォオ！（苦痛の呻き）",
      "source_en": "Gwoooohh! (Pained groans)",
      "text": "Gwoaah! (stöhnt vor Schmerz)"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "見てる場合じゃねえ！\r\n止めるぞ！",
      "source_en": "Stop gawking!\r\nI'm going to put a stop to this!",
      "text": "Steht nicht nur herum!\r\nWir müssen ihn aufhalten!"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "ふんっ！（リアクションボイス）",
      "source_en": "Huh! (reacting)",
      "text": "Hmpf! (schnaubt)"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "うおっ――（リアクションボイス）",
      "source_en": "Whoa— (reacting)",
      "text": "Uah … (erschrickt)"
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_en",
      "source_jp": "きゃっ――（リアクションボイス）",
      "source_en": "Eek— (reacting)",
      "text": "Ah! (schreit auf)"
    },
    {
      "key": "",
      "read_index": "15",
      "tag_source": "source_en",
      "source_jp": "わっ――（リアクションボイス）",
      "source_en": "Whoa— (reacting)",
      "text": "Oh! (erschrickt)"
    },
    {
      "key": "",
      "read_index": "16",
      "tag_source": "source_en",
      "source_jp": "くそっ！　このままじゃ――",
      "source_en": "Damn! It can't go on like this—",
      "text": "Verdammt! Wenn das so weitergeht …"
    },
    {
      "key": "",
      "read_index": "17",
      "tag_source": "source_en",
      "source_jp": "ぐぐっ（リアクションボイス）",
      "source_en": "Guguh (reacting)",
      "text": "Ghh … (keucht)"
    },
    {
      "key": "",
      "read_index": "18",
      "tag_source": "source_en",
      "source_jp": "顔をあげて！",
      "source_en": "Raise your head!",
      "text": "Hebt den Kopf!"
    },
    {
      "key": "",
      "read_index": "19",
      "tag_source": "source_en",
      "source_jp": "あなたが屈してはなりません",
      "source_en": "You must not yield.",
      "text": "Ihr dürft nicht aufgeben."
    },
    {
      "key": "",
      "read_index": "20",
      "tag_source": "source_en",
      "source_jp": "さあ、力を奮うのです",
      "source_en": "Now, gather your strength.",
      "text": "Sammelt jetzt Eure Kräfte."
    },
    {
      "key": "",
      "read_index": "21",
      "tag_source": "source_en",
      "source_jp": "んっ――（リアクションボイス）",
      "source_en": "Nngh— (reacting)",
      "text": "Nngh … (stöhnt)"
    },
    {
      "key": "",
      "read_index": "22",
      "tag_source": "source_en",
      "source_jp": "んっ――（リアクションボイス）",
      "source_en": "Nngh— (reacting)",
      "text": "Nngh … (stöhnt)"
    },
    {
      "key": "",
      "read_index": "23",
      "tag_source": "source_en",
      "source_jp": "んっ――（リアクションボイス）",
      "source_en": "Nngh— (reacting)",
      "text": "Nngh … (stöhnt)"
    },
    {
      "key": "",
      "read_index": "24",
      "tag_source": "source_en",
      "source_jp": "ぬう――（リアクションボイス）",
      "source_en": "Nuuh— (Pained groans)",
      "text": "Nuuuh … (stöhnt vor Schmerz)"
    },
    {
      "key": "",
      "read_index": "25",
      "tag_source": "source_en",
      "source_jp": "ゴフッ、",
      "source_en": "Huff,",
      "text": "Ghh …"
    },
    {
      "key": "",
      "read_index": "26",
      "tag_source": "source_en",
      "source_jp": "安心するがいい――",
      "source_en": "You should take comfort in...",
      "text": "Sei unbesorgt …"
    },
    {
      "key": "",
      "read_index": "27",
      "tag_source": "source_en",
      "source_jp": "悲しむ者など微塵も残さぬ――",
      "source_en": "Not a trace of sorrow will remain—",
      "text": "Es wird niemand übrig bleiben, der um dich trauert …"
    },
    {
      "key": "",
      "read_index": "28",
      "tag_source": "source_en",
      "source_jp": "ヌ――うう――（苦痛の呻き）",
      "source_en": "Nnngh— (Pained groans)",
      "text": "Nnngh … (stöhnt vor Schmerz)"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
