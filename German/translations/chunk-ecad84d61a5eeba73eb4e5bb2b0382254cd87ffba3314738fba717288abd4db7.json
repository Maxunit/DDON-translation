{
  "gmd_path": "ui\\00_message\\event\\st0430\\ev010.gmd",
  "arc_path": "\\event\\st0430\\st0430ev010.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "擬竜は――いないんだね",
      "source_en": "There are no pseudo-dragons, right?",
      "text": "Also ist der Trugdrache nicht hier …"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "はっきりしたね",
      "source_en": "It's clear now.",
      "text": "Jetzt wissen wir es."
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "擬竜は白竜の力で存在していたんだ\r\nそんな予感はしたけどね",
      "source_en": "Pseudo-dragons existed with the White Dragon's\r\npower. I had a hunch like that.",
      "text": "Der Trugdrache konnte nur durch die Kraft des Weißen Drachen existieren.\r\nDas hatte ich schon befürchtet."
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "全財産賭けてなかったか？",
      "source_en": "Didn't you bet your entire fortune on it?",
      "text": "Hast du darauf nicht dein ganzes Vermögen verwettet?"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "察してくださいよ",
      "source_en": "Please understand.",
      "text": "Jetzt lass das doch bitte."
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "わたしは――信じてたよ",
      "source_en": "I believed—",
      "text": "Ich hatte gehofft …"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "リズ？",
      "source_en": "Lise?",
      "text": "Lise?"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "わたし――",
      "source_en": "I...",
      "text": "Ich …"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "おい！",
      "source_en": "Hey!",
      "text": "He!"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
