  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "待ってくれよー！",
      "source_en": "Wait for me!",
      "text": "Warte auf mich!"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "はぁ――はぁ――\r\nジョゼフ様のご命令でね",
      "source_en": "Haa—haa—\r\nBy Master Joseph's orders.",
      "text": "Puh … Puh …\r\nMeister Joseph hat mich geschickt."
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "メイリーフを見つけて\r\n仲良くなっておけって――",
      "source_en": "He told me to find Mayleaf and befriend her-",
      "text": "Ich soll Mayleaf suchen und mich mit ihr anfreunden …"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "――なんだろうね、いったい",
      "source_en": "I wonder... What's that?!",
      "text": "Was er sich wohl dabei gedacht hat?"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "あ！？",
      "source_en": "Ah!?",
      "text": "Hä?!"
    }
  ],
