{
  "gmd_path": "ui\\00_message\\event\\st3300\\ev005.gmd",
  "arc_path": "\\event\\st3300\\st3300ev005.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "ウッ！　グッ――\r\n（倒れる際のリアクション）",
      "source_en": "Ugh! Guh—\r\n(Reaction when falling)",
      "text": "Ugh! Gah …\r\n(Stöhnt beim Sturz)"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "コハッ――ハッ――\r\n（倒れている際のリアクション、呼吸）",
      "source_en": "Cough... Huff...\r\n(Breathing laboriously)",
      "text": "Hust … Hah …\r\n(Atmet schwer am Boden)"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "わたしは――闇の中では倒れぬ",
      "source_en": "I... will not fall in the darkness.",
      "text": "Ich … werde in der Finsternis nicht fallen."
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "ウゥゥ――ハッ！！\r\n（剣を構える際の気合、リアクション）",
      "source_en": "Ughh! Hah!!\r\n(Gathering strength while preparing the sword,\r\nreaction)",
      "text": "Uugh … Hah!\r\n(Sammelt seine Kraft und\r\nhebt das Schwert)"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "こっちだって――まだまだ！",
      "source_en": "Bring it on... I'm not done yet!",
      "text": "Ich … Ich bin auch noch nicht fertig!"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "おまえら、行けそうか",
      "source_en": "Do you think you can handle it?",
      "text": "Könnt ihr noch?"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "俺は――！？",
      "source_en": "And me!?",
      "text": "Was ist mit mir …?!"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "なんだろう――身体が重くて――",
      "source_en": "I wonder... why does my body feel so heavy...",
      "text": "Was ist das? Mein Körper fühlt sich so schwer an …"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "闇が身体に入り込む――",
      "source_en": "Darkness is entering the body...",
      "text": "Die Finsternis dringt in unsere Körper ein …"
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "はぁぁぁぁぁっ！（リアクションボイス）",
      "source_en": "Haaaaah! (reacting)",
      "text": "Haaaaah! (Aufschrei)"
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "うっ（リアクションボイス）",
      "source_en": "Ugh! (reacting)",
      "text": "Ugh! (Stöhnen)"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "くっ（リアクションボイス）",
      "source_en": "Ngh! (reacting)",
      "text": "Ngh! (Stöhnen)"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "ああっ（リアクションボイス）",
      "source_en": "Ahh! (reacting)",
      "text": "Ah! (Aufschrei)"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "隊長！",
      "source_en": "Captain!",
      "text": "Hauptmann!"
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_en",
      "source_jp": "え？",
      "source_en": "Huh?",
      "text": "Hä?"
    },
    {
      "key": "",
      "read_index": "15",
      "tag_source": "source_en",
      "source_jp": "なんだあれは――",
      "source_en": "What the hell was that...",
      "text": "Was war das denn?"
    },
    {
      "key": "",
      "read_index": "16",
      "tag_source": "source_en",
      "source_jp": "セシリーの竜力！",
      "source_en": "Cecily's Dragon Force!",
      "text": "Cecilys Drachenkraft!"
    },
    {
      "key": "",
      "read_index": "17",
      "tag_source": "source_en",
      "source_jp": "ネド王子の竜力も！",
      "source_en": "Prince Nedo's Dragon Force too!",
      "text": "Und die von Prinz Nedo!"
    },
    {
      "key": "",
      "read_index": "18",
      "tag_source": "source_en",
      "source_jp": "ぐおおおおおっ！",
      "source_en": "Goooahhh!",
      "text": "Guaaah!"
    },
    {
      "key": "",
      "read_index": "19",
      "tag_source": "source_en",
      "source_jp": "おぶっ！！！",
      "source_en": "Oof!!!",
      "text": "Uff!"
    },
    {
      "key": "",
      "read_index": "20",
      "tag_source": "source_en",
      "source_jp": "なぜだ――わたしは倒れん――",
      "source_en": "Why... I won't fall...",
      "text": "Warum …? Ich kann nicht fallen …"
    },
    {
      "key": "",
      "read_index": "21",
      "tag_source": "source_en",
      "source_jp": "必ず、理を――",
      "source_en": "We must uphold order—",
      "text": "Ich muss die Ordnung …"
    },
    {
      "key": "",
      "read_index": "22",
      "tag_source": "source_en",
      "source_jp": "（苦鳴）ぼはああああああっ！！！",
      "source_en": "(Pained yell) Goaaaaaaaah!!!",
      "text": "(Schmerzensschrei) Guuaaaaah!"
    },
    {
      "key": "",
      "read_index": "23",
      "tag_source": "source_en",
      "source_jp": "崩して――見せ――よう――",
      "source_en": "Let it crumble—show—them—",
      "text": "… zum Einsturz bringen … Ich … werde …"
    },
    {
      "key": "",
      "read_index": "24",
      "tag_source": "source_en",
      "source_jp": "やった！",
      "source_en": "Got it!",
      "text": "Geschafft!"
    },
    {
      "key": "",
      "read_index": "25",
      "tag_source": "source_en",
      "source_jp": "それでいい",
      "source_en": "That's fine.",
      "text": "So ist es recht."
    },
    {
      "key": "",
      "read_index": "26",
      "tag_source": "source_en",
      "source_jp": "レオ！",
      "source_en": "Leo!",
      "text": "Leo!"
    },
    {
      "key": "",
      "read_index": "27",
      "tag_source": "source_en",
      "source_jp": "レオ統率！",
      "source_en": "Lead the way, Leo!",
      "text": "Kommandant Leo!"
    },
    {
      "key": "",
      "read_index": "28",
      "tag_source": "source_en",
      "source_jp": "まもなく黒竜のための門が開く",
      "source_en": "The gate for the Black Dragon will soon be open.",
      "text": "Bald öffnet sich das Tor für den Schwarzen Drachen."
    },
    {
      "key": "",
      "read_index": "29",
      "tag_source": "source_en",
      "source_jp": "何を言ってるんですか！？",
      "source_en": "What are you talking about?!",
      "text": "Wovon redet Ihr da?!"
    },
    {
      "key": "",
      "read_index": "30",
      "tag_source": "source_en",
      "source_jp": "いよいよ現れるぞ",
      "source_en": "They're going to show up at last.",
      "text": "Endlich wird er erscheinen."
    },
    {
      "key": "",
      "read_index": "31",
      "tag_source": "source_en",
      "source_jp": "待ちやがれ！",
      "source_en": "Wait for it!",
      "text": "Bleib gefälligst stehen!"
    },
    {
      "key": "",
      "read_index": "32",
      "tag_source": "source_en",
      "source_jp": "んっ、",
      "source_en": "Hmm,",
      "text": "Hm …"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
