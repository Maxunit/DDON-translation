{
  "gmd_path": "ui\\00_message\\event\\st3111\\ev005.gmd",
  "arc_path": "\\event\\st3111\\st3111ev005.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "よし！（敵を倒したリアクション）",
      "source_en": "Alright! (Reaction after defeating an enemy)",
      "text": "Geschafft! (jubelt nach dem Sieg)"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "なんだぁ！？",
      "source_en": "What!?",
      "text": "Was?!"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "あっ！",
      "source_en": "Ah!",
      "text": "Ah!"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "レオ！！",
      "source_en": "Leo!!",
      "text": "Leo!"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "レオ統率！！",
      "source_en": "Leo, take command!!",
      "text": "Leo, übernimm das Kommando!"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "まさか――",
      "source_en": "No way...",
      "text": "Das ist doch nicht möglich …"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "そんなはず、ないですよね！？",
      "source_en": "It can't be, right!??",
      "text": "Das kann nicht sein, oder?!"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "てめぇ！　何のつもりだ！",
      "source_en": "You! What do you think you're doing!?",
      "text": "Was zum Teufel treibst du da?!"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "黒騎士とつるんでやがるのかっ！",
      "source_en": "Are you consorting with the Black Knight!?",
      "text": "Machst du etwa gemeinsame Sache mit dem Schwarzen Ritter?!"
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "どういうことだ！　説明しろ！！",
      "source_en": "What's going on! Explain!!",
      "text": "Was geht hier vor? Sag es uns!"
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "強くあれ――\r\nミシアルは俺たちにそう託したよな？",
      "source_en": "Be strong...\r\nThat's what Mysial entrusted to us, right?",
      "text": "Stark zu sein …\r\nDas hat Mysial uns doch aufgetragen, oder?"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "俺と、おまえに",
      "source_en": "Me, and you...",
      "text": "Mir und dir …"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "うおっ！　なんだっ！",
      "source_en": "Whoa! What's happening!",
      "text": "Ah! Was geschieht hier?!"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "くっ！　体が！",
      "source_en": "Damn! My body!",
      "text": "Verdammt! Mein Körper …"
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_en",
      "source_jp": "飛ばされちゃう！",
      "source_en": "I'll be thrown off!",
      "text": "Es reißt mich fort!"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
