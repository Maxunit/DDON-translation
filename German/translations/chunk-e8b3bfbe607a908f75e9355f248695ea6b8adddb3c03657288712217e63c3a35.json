{
  "gmd_path": "ui\\00_message\\quest\\q50300000.gmd",
  "arc_path": "\\quest\\q50300000.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_jp",
      "source_jp": "油断するな",
      "source_en": "",
      "text": "Bleib wachsam."
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_jp",
      "source_jp": "悪くない――その調子だ",
      "source_en": "",
      "text": "Nicht schlecht. Weiter so."
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_jp",
      "source_jp": "目の前の敵に集中するんだ",
      "source_en": "",
      "text": "Konzentrier dich auf den Gegner vor dir."
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_jp",
      "source_jp": "切り込むぞ！",
      "source_en": "",
      "text": "Jetzt greifen wir an!"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_jp",
      "source_jp": "よし、ここは制圧した",
      "source_en": "",
      "text": "Gut, dieser Abschnitt ist gesichert."
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_jp",
      "source_jp": "それで良い、次に向かうぞ！",
      "source_en": "",
      "text": "Sehr gut. Weiter zum nächsten!"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_jp",
      "source_jp": "新手の敵だ、注意しろ！",
      "source_en": "",
      "text": "Verstärkung für den Feind! Pass auf!"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_jp",
      "source_jp": "今こそ名をあげる時だ――",
      "source_en": "",
      "text": "Jetzt kannst du dir einen Namen machen …"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_jp",
      "source_jp": "相変わらずの臭いだな",
      "source_en": "",
      "text": "Der Gestank ist ganz der alte."
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_jp",
      "source_jp": "今日こそ決着を付けてくれる！",
      "source_en": "",
      "text": "Heute klären wir ein für alle Mal, wer stärker ist!"
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_jp",
      "source_jp": "逃がしたか――",
      "source_en": "",
      "text": "Er ist entkommen …"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_jp",
      "source_jp": "覚者の命、全て狩り取ってくれるわ",
      "source_en": "",
      "text": "Ich jage euch alle, bis kein Erweckter mehr übrig ist!"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_jp",
      "source_jp": "これは楽しめそうだな、褐色の女戦士よ",
      "source_en": "",
      "text": "Das könnte lustig werden, du braungebrannte Kriegerin."
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_jp",
      "source_jp": "覚者の命は値千金！　奪え！",
      "source_en": "",
      "text": "Erweckte bringen ein Vermögen! Holt sie euch!"
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_jp",
      "source_jp": "ほう――その細腕でやるな",
      "source_en": "",
      "text": "Oh … ganz schön stark für so dünne Arme."
    },
    {
      "key": "",
      "read_index": "15",
      "tag_source": "source_jp",
      "source_jp": "今日はここまでだ",
      "source_en": "",
      "text": "Für heute reicht’s."
    },
    {
      "key": "",
      "read_index": "16",
      "tag_source": "source_jp",
      "source_jp": "おまえの力では俺は倒せぬわ",
      "source_en": "",
      "text": "Du bist zu schwach, um mich zu besiegen."
    },
    {
      "key": "",
      "read_index": "17",
      "tag_source": "source_jp",
      "source_jp": "まさか――この――俺が――",
      "source_en": "",
      "text": "Das kann nicht sein … Ich …"
    },
    {
      "key": "",
      "read_index": "18",
      "tag_source": "source_jp",
      "source_jp": "うがあぁぁぁぁぁぁ――",
      "source_en": "",
      "text": "Uaaaargh …"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
