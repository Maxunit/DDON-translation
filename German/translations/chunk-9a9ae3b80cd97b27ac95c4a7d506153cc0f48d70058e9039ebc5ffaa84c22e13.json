  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "怯むな！　戦え！",
      "source_en": "Don't falter! Fight!",
      "text": "Weicht nicht zurück! Kämpft!"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "みな、よく聞け！",
      "source_en": "Listen closely, everyone!",
      "text": "Hört alle gut zu!"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "心強い援軍が来てくれた",
      "source_en": "Some much-needed reinforcements have arrived.",
      "text": "Wir haben endlich Verstärkung!"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "統率の右腕と呼ばれし者だ――",
      "source_en": "Known as the right-hand of our\r\ncommander.",
      "text": "Zu uns kommt Leos rechte Hand,\r\nvon der ihr alle schon gehört habt …"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "さあ、もうひと揉みしてやろうぞ！",
      "source_en": "Now, let's give it a final pounding!",
      "text": "Los, machen wir ihnen noch einmal ordentlich Druck!"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "ふん",
      "source_en": "Hmph",
      "text": "Hm."
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "はっ",
      "source_en": "Yes, ser!",
      "text": "Jawohl!"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "うぉおおお――はっ！！",
      "source_en": "Whoa—hah!!",
      "text": "Raaah … Ha!"
    },
