{
  "gmd_path": "ui\\00_message\\event\\st0132\\ev005.gmd",
  "arc_path": "\\event\\st0132\\st0132ev005.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "ふう",
      "source_en": "Phew",
      "text": "Puh …"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "奇襲作戦成功ですね",
      "source_en": "A successful surprise attack.",
      "text": "Der Überraschungsangriff ist gelungen."
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "皆さん、静かに！",
      "source_en": "Quiet, everyone!",
      "text": "Seid alle still!"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "どうした？",
      "source_en": "Hm, what is it?",
      "text": "Hm? Was ist los?"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "悪しき竜が――来ます",
      "source_en": "The evil dragon—he's coming.",
      "text": "Der Böse Drache … Er kommt."
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "え！？　隠れなきゃ！",
      "source_en": "What?! We have to hide!",
      "text": "Was?! Wir müssen uns verstecken!"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "王子、こっち！",
      "source_en": "Prince, this way!",
      "text": "Prinz, hierher!"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "王子！",
      "source_en": "Prince!",
      "text": "Prinz!"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "王子よ――",
      "source_en": "Prince...",
      "text": "Prinz …"
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "おまえなど取るに足りん――",
      "source_en": "You're not even worth my time.",
      "text": "Du bist meine Zeit nicht wert."
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "悪しき竜よ\r\nその言葉――そっくりお返ししましょう",
      "source_en": "Evil Dragon...\r\nI shall return those words to you in full.",
      "text": "Böser Drache …\r\nDasselbe kann ich von Euch sagen."
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "それがおまえの最後の言葉かぁ！",
      "source_en": "Those are your final words!",
      "text": "Das sollen deine letzten Worte sein?!"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "ウクククク――（漏れる笑い）",
      "source_en": "Hehehehe... (muffled laughter)",
      "text": "Hihihi … (lacht verhalten)"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "レスタニアの覚者よ――",
      "source_en": "Arisen of Lestania...",
      "text": "Erweckte aus Lestania …"
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_en",
      "source_jp": "あがけ",
      "source_en": "Struggle",
      "text": "Wehrt euch."
    },
    {
      "key": "",
      "read_index": "15",
      "tag_source": "source_en",
      "source_jp": "もぉがけぇ！",
      "source_en": "Keep fighting!",
      "text": "Kämpft weiter!"
    },
    {
      "key": "",
      "read_index": "16",
      "tag_source": "source_en",
      "source_jp": "だが結末は動かん――",
      "source_en": "But the outcome will not change...",
      "text": "Am Ausgang ändert das nichts …"
    },
    {
      "key": "",
      "read_index": "17",
      "tag_source": "source_en",
      "source_jp": "この絶望の大陸を――\r\nせいぜい楽しむがいい！",
      "source_en": "Enjoy this Land of Despair to your heart's\r\ncontent!",
      "text": "Genießt dieses Land der Verzweiflung,\r\nsolange ihr noch könnt!"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
