{
  "gmd_path": "ui\\00_message\\event\\st0101\\ev000.gmd",
  "arc_path": "\\event\\st0101\\st0101ev000.arc",
  "entries": [
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "ゴッ！",
      "source_en": "Go!",
      "text": "Goh!"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "ゴアッ！",
      "source_en": "Gua!",
      "text": "Guaah!"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "ゲフッ！",
      "source_en": "Gefu!",
      "text": "Gch!"
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "それだけか！",
      "source_en": "Is that all?",
      "text": "Ist das alles?"
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "さあ来い！",
      "source_en": "Come on!",
      "text": "Na, komm doch!"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "遅い！",
      "source_en": "Too slow!",
      "text": "Zu langsam!"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "そこだ！",
      "source_en": "There!",
      "text": "Da!"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "フッ！",
      "source_en": "Hmph!",
      "text": "Hmpf!"
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_en",
      "source_jp": "なっ―！？",
      "source_en": "What...?!",
      "text": "Was …?!"
    },
    {
      "key": "",
      "read_index": "15",
      "tag_source": "source_en",
      "source_jp": "グフッ、グフッ！",
      "source_en": "Gufu, gufu!",
      "text": "Gh, gh!"
    },
    {
      "key": "",
      "read_index": "16",
      "tag_source": "source_en",
      "source_jp": "ゴホッ！",
      "source_en": "Ahem!",
      "text": "Hust!"
    },
    {
      "key": "",
      "read_index": "17",
      "tag_source": "source_en",
      "source_jp": "ゴプッ―！",
      "source_en": "Goppu!",
      "text": "Gch …!"
    },
    {
      "key": "",
      "read_index": "18",
      "tag_source": "source_en",
      "source_jp": "うっ―がはぁッ―！",
      "source_en": "Ugh—Gahaha!",
      "text": "Uh … aaah!"
    },
    {
      "key": "",
      "read_index": "19",
      "tag_source": "source_en",
      "source_jp": "チッ―！",
      "source_en": "Tch...!",
      "text": "Tss …!"
    },
    {
      "key": "",
      "read_index": "20",
      "tag_source": "source_en",
      "source_jp": "まだだ！",
      "source_en": "Not yet!",
      "text": "Noch nicht!"
    },
    {
      "key": "",
      "read_index": "21",
      "tag_source": "source_en",
      "source_jp": "くそっ！",
      "source_en": "Damn it!",
      "text": "Verdammt!"
    },
    {
      "key": "",
      "read_index": "22",
      "tag_source": "source_en",
      "source_jp": "はぁ、はぁ―",
      "source_en": "Haa, haa...",
      "text": "Haah, haah …"
    },
    {
      "key": "",
      "read_index": "23",
      "tag_source": "source_en",
      "source_jp": "調子に、乗るな―！",
      "source_en": "Don't get carried away!",
      "text": "Werd bloß nicht übermütig!"
    },
    {
      "key": "",
      "read_index": "24",
      "tag_source": "source_en",
      "source_jp": "舐めるな！",
      "source_en": "Don't underestimate me!",
      "text": "Unterschätz mich nicht!"
    },
    {
      "key": "",
      "read_index": "25",
      "tag_source": "source_en",
      "source_jp": "だ、だめだ―",
      "source_en": "I-it's no good...",
      "text": "D-das geht nicht …"
    },
    {
      "key": "",
      "read_index": "26",
      "tag_source": "source_en",
      "source_jp": "引け！",
      "source_en": "Retreat!",
      "text": "Rückzug!"
    },
    {
      "key": "",
      "read_index": "27",
      "tag_source": "source_en",
      "source_jp": "立て直せ！",
      "source_en": "Stand firm!",
      "text": "Sammelt euch wieder!"
    },
    {
      "key": "",
      "read_index": "28",
      "tag_source": "source_en",
      "source_jp": "ああ―ああああ―！",
      "source_en": "Ah... aaahhhhh....!",
      "text": "Ah … aaaaaah!"
    },
    {
      "key": "",
      "read_index": "29",
      "tag_source": "source_en",
      "source_jp": "だめ―か―！",
      "source_en": "Is it... hopeless?",
      "text": "Ist es … vorbei?"
    },
    {
      "key": "",
      "read_index": "30",
      "tag_source": "source_en",
      "source_jp": "ゥオオオオォォォォ―！",
      "source_en": "Goooooo!",
      "text": "Uoooooh!"
    },
    {
      "key": "",
      "read_index": "31",
      "tag_source": "source_en",
      "source_jp": "オオオオ―――――ッッ！！",
      "source_en": "Ooooooohhhhh!!",
      "text": "Ooooooh!"
    },
    {
      "key": "",
      "read_index": "32",
      "tag_source": "source_en",
      "source_jp": "ひるむな！",
      "source_en": "Don't falter!",
      "text": "Nicht zurückweichen!"
    },
    {
      "key": "",
      "read_index": "33",
      "tag_source": "source_en",
      "source_jp": "行け！",
      "source_en": "Go!",
      "text": "Los!"
    },
    {
      "key": "",
      "read_index": "34",
      "tag_source": "source_en",
      "source_jp": "蹴散らせ！",
      "source_en": "Kick them away!",
      "text": "Fegt sie weg!"
    },
    {
      "key": "",
      "read_index": "35",
      "tag_source": "source_en",
      "source_jp": "仕留めろ！",
      "source_en": "Finish them off!",
      "text": "Macht sie fertig!"
    },
    {
      "key": "",
      "read_index": "36",
      "tag_source": "source_en",
      "source_jp": "何っ―！？",
      "source_en": "What―!?",
      "text": "Was?!"
    },
    {
      "key": "",
      "read_index": "37",
      "tag_source": "source_en",
      "source_jp": "このっ―！！",
      "source_en": "This—!!",
      "text": "Du …!"
    },
    {
      "key": "",
      "read_index": "38",
      "tag_source": "source_en",
      "source_jp": "ゴフッ―！！",
      "source_en": "Guhh!!",
      "text": "Uff!"
    },
    {
      "key": "",
      "read_index": "39",
      "tag_source": "source_en",
      "source_jp": "まずい―！",
      "source_en": "Oh no - this is bad!",
      "text": "Verdammt …!"
    },
    {
      "key": "",
      "read_index": "40",
      "tag_source": "source_en",
      "source_jp": "なんだと―！？",
      "source_en": "What did you say!?",
      "text": "Wie bitte?!"
    },
    {
      "key": "",
      "read_index": "41",
      "tag_source": "source_en",
      "source_jp": "ぐっ―",
      "source_en": "Guh―",
      "text": "Ugh …"
    },
    {
      "key": "",
      "read_index": "42",
      "tag_source": "source_en",
      "source_jp": "ぐわああっ！！",
      "source_en": "Gwaaaaah!!",
      "text": "Gwaaah!"
    },
    {
      "key": "",
      "read_index": "43",
      "tag_source": "source_en",
      "source_jp": "アーグラー！",
      "source_en": "Aargh!",
      "text": "Aaglar!"
    },
    {
      "key": "",
      "read_index": "45",
      "tag_source": "source_en",
      "source_jp": "ま、待て―",
      "source_en": "W-Wait!",
      "text": "W-warte …!"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
