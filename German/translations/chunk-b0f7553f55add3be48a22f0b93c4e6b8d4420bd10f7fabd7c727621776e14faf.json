{
  "gmd_path": "ui\\00_message\\event\\st0403\\ev005.gmd",
  "arc_path": "\\event\\st0403\\st0403ev005.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "あれだ！　あれが《命の器》！",
      "source_en": "There it is! That's the [Vessel of Life]!",
      "text": "Da ist es! Das Gefäß des Lebens!"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "図版で見たとおり！",
      "source_en": "Just like in the drawing!",
      "text": "Genau wie auf der Zeichnung!"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "オマイがアルケミーの継承者とな？",
      "source_en": "You, an heir to Alchemy?",
      "text": "Du willst ein Erbe der Alchemie sein?"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "世継ぎなど",
      "source_en": "Heirs and inheriators.",
      "text": "Erben …"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "いらん！",
      "source_en": "Not needed!",
      "text": "Braucht kein Mensch!"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "誰が誰やら――",
      "source_en": "Now, who's who...",
      "text": "Wer ist hier wer …?"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "覚者たちよ！\r\n",
      "source_en": "Arisen, all of you!",
      "text": "Hört zu, Erweckte!"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "まず我ら騎士団に任せよ！",
      "source_en": "First, leave it to our Knights' Order!",
      "text": "Überlasst das erst einmal uns Rittern!"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "この新手の敵の戦いぶり――\r\nしかと検分されたし！",
      "source_en": "The fighting style of this new enemy—\r\nLet it be thoroughly examined!",
      "text": "Seht genau hin,\r\nwie dieser neue Feind kämpft!"
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "（息遣い）",
      "source_en": "(Breathing)",
      "text": "(Atemgeräusch)"
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "（息遣い）",
      "source_en": "(Breathing)",
      "text": "(Atemgeräusch)"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "ウオオオオオォォォォッッ！",
      "source_en": "Uwaaaaaah!",
      "text": "Aaaaaaah!"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
