{
  "gmd_path": "ui\\00_message\\quest\\q50104000.gmd",
  "arc_path": "\\quest\\q50104000.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_jp",
      "source_jp": "おお？　オマイら、命が惜しくないのか？",
      "source_en": "",
      "text": "Oh? Hängt ihr denn gar nicht an eurem Leben?"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_jp",
      "source_jp": "モゴックのやつヘマしやがったか――",
      "source_en": "",
      "text": "Hat dieser Mogok also versagt …"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_jp",
      "source_jp": "ふん――オークはオークか",
      "source_en": "",
      "text": "Hmpf, ein Ork bleibt eben ein Ork."
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_jp",
      "source_jp": "お？　ここで何してる――ってか？",
      "source_en": "",
      "text": "Oh? Ihr wollt wissen, was ich hier mache?"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_jp",
      "source_jp": "そりゃきっとオマイと同じだ！",
      "source_en": "",
      "text": "Bestimmt dasselbe wie ihr!"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_jp",
      "source_jp": "煩わしい――覚者どもが――",
      "source_en": "",
      "text": "Diese lästigen Erweckten …"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_jp",
      "source_jp": "だがゲートはもうコジ開けた",
      "source_en": "",
      "text": "Aber das Tor habe ich schon aufgebrochen."
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_jp",
      "source_jp": "とびきりの混沌を世界に落としてやる！",
      "source_en": "",
      "text": "Ich werde die Welt ins tiefste Chaos stürzen!"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_jp",
      "source_jp": "がはははっ！",
      "source_en": "",
      "text": "Gahahaha!"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
