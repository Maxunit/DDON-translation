    {
      "key": "q50104000_00_47",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "竜の翼たる歴戦の覚者たちよ\r\n指輪を求め、空に浮かぶ王宮に向かい\r\n真なる黄金宮への道を探し出せ",
      "source_en": "O battle-hardened Arisen, Wings of thy Dragon.\r\nSeek the ring and head to the floating\r\nRoyal Palace in the sky and uncover the path\r\nto the true Golden Land.",
      "text": "Erfahrene Erweckte, ihr Schwingen des Drachen!\r\nSucht den Ring und begebt euch zum schwebenden Königspalast.\r\nDort werdet ihr den Weg\r\nin den wahren Goldenen Palast finden."
    },
    {
      "key": "q50104000_00_1769",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "制限時間内に討伐対象の敵を全て倒す",
      "source_en": "Defeat all of the target enemies within the time limit",
      "text": "Besiegt alle Zielgegner, bevor die Zeit abläuft."
    },
    {
      "key": "q50104000_00_1770",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "敵を殲滅する",
      "source_en": "Eliminate the enemy",
      "text": "Besiegt die Feinde."
    },
    {
      "key": "q50104000_00_1771",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "次なる敵を探し出す",
      "source_en": "Find your next enemy",
      "text": "Sucht euren nächsten Gegner."
    },
    {
      "key": "q50104000_00_1772",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "扉の守護者を討伐する",
      "source_en": "Defeat the guardians at the door",
      "text": "Besiegt die Wächter am Tor."
    },
    {
