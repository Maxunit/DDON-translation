{
  "gmd_path": "ui\\00_message\\event\\st0120\\ev025.gmd",
  "arc_path": "\\event\\st0120\\st0120ev025.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "――なぜだ！　どういうことだ！？\r\n黒騎士よ！　どこにいる！",
      "source_en": "Why! What is happening!?\r\nBlack Knight! Where are you?",
      "text": "Warum?! Was soll das?!\r\nSchwarzer Ritter! Wo bist du?"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "今さらわたしを見捨てるのか！",
      "source_en": "Are you abandoning me now, of all times!",
      "text": "Willst du mich jetzt im Stich lassen?!"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "ロイグが？\r\n黒い霧に――！！",
      "source_en": "Loeg? In the black mist—!!",
      "text": "Loeg?! Diese schwarze Nebelwand …"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "おい、近づくな！",
      "source_en": "Hey, don't come any closer!",
      "text": "He, geh da nicht näher ran!"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "そこ！　足元に――",
      "source_en": "There! At your feet...",
      "text": "Da! Vor deinen Füßen …"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "《原始の雫》！",
      "source_en": "[Primeval Drops]!",
      "text": "Die Urquelltropfen!"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "まだ希望は消えていない――",
      "source_en": "Hope is not yet extinguished...",
      "text": "Es gibt noch Hoffnung …"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "これで――フィンダムは救われます！",
      "source_en": "With this, Phindym will be saved!",
      "text": "Damit können wir Phindym retten!"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
