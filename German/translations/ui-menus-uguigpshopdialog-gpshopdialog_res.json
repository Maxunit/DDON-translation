    {
      "key": "OSD_eventcode_title",
      "read_index": "17",
      "source_jp": "16ケタのイベントコードを入力してください",
      "source_en": "Please enter your 16-digit event code",
      "text": "Gib den 16-stelligen Eventcode ein."
