{
  "gmd_path": "ui\\00_message\\quest\\q90000119.gmd",
  "arc_path": "\\quest\\q90000119.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "気を抜くなよ",
      "source_en": "Don't let your guard down.",
      "text": "Lass nicht nach."
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "良い動きだ！",
      "source_en": "Good move!",
      "text": "Gut reagiert!"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "落ち着いて仕留めるんだ！",
      "source_en": "Stay calm and finish them off!",
      "text": "Bleib ruhig und bring es zu Ende!"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "さあ！全ての敵を切り倒せ！",
      "source_en": "Okay! Cut down every enemy!",
      "text": "Los! Lass keinen Gegner übrig!"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "この調子で駆け抜けるぞ！",
      "source_en": "Push through at this pace!",
      "text": "Weiter so, wir müssen hier durch!"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "よくやった、付いてこい！",
      "source_en": "Well done, follow me!",
      "text": "Gut gemacht. Folge mir!"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "ほう――大将のお出ましだ",
      "source_en": "Well - here comes the general.",
      "text": "Sieh an … Da kommt der Anführer."
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "こいつは手強いな",
      "source_en": "This one is tough.",
      "text": "Der ist zäh."
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "覚者の命、全て狩り取ってくれるわ",
      "source_en": "I will take the lives of all Arisen.",
      "text": "Ich jage euch alle, bis kein Erweckter mehr übrig ist!"
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "会いに来てやったぞ、金色の戦士よ",
      "source_en": "I have come to meet you, golden warrior.",
      "text": "Ich bin gekommen, um dich zu sehen, goldener Krieger."
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "覚者の命は値千金！　奪え！",
      "source_en": "The life of an Arisen is invaluable! Seize it!",
      "text": "Erweckte bringen ein Vermögen! Holt sie euch!"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "楽しませてくれる",
      "source_en": "Let me entertain you.",
      "text": "Du machst mir Spaß."
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "まさか――この――俺が――",
      "source_en": "I can't believe... that I...",
      "text": "Das kann nicht sein … Ich …"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "存分に楽しませてもらったぞ――",
      "source_en": "I've thoroughly enjoyed myself――",
      "text": "Ich hatte mein Vergnügen …"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
