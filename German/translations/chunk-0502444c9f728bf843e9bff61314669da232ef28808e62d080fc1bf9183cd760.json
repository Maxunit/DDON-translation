  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "これかよ――\r\nこれが――",
      "source_en": "Is this it—\r\nThis is it...",
      "text": "Ist es das hier …?\r\nDas muss es sein …"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "胸が――",
      "source_en": "My heart...",
      "text": "Mein Herz …"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "熱い、傷が――疼きます――",
      "source_en": "It's hot, my wounds... they ache...",
      "text": "Es brennt … Meine Wunde pocht …"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "どうしよう――抑えられない――",
      "source_en": "What should I do... I can't hold back...",
      "text": "Was soll ich tun? Ich kann es nicht mehr zurückhalten …"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "セシリー――",
      "source_en": "Cecily—",
      "text": "Cecily …"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "ほらな！\r\nそうくると思ったぜ！",
      "source_en": "See!\r\nI knew it would come to this!",
      "text": "Siehst du!\r\nIch wusste doch, dass es so kommen würde!"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "ロイグ！",
      "source_en": "Loeg!",
      "text": "Loeg!"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "竜との約束を悔いるがいい",
      "source_en": "Regret your promise with the dragon!",
      "text": "Du wirst dein Versprechen an den Drachen bereuen!"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "なんだこりゃ！\r\n最悪の展開じゃねえか！",
      "source_en": "What the hell is this!\r\nThis is the worst outcome!",
      "text": "Was zum Teufel ist das?!\r\nSchlimmer hätt’s nicht kommen können!"
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "おい、さっさと引き上げるぞ",
      "source_en": "Hey, let's withdraw quickly.",
      "text": "Los, schnell weg hier!"
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "セシリーを運べ！\r\n俺はロイグだ！",
      "source_en": "Move Cecily!\r\nLeave Loeg to me!",
      "text": "Tragt Cecily weg!\r\nIch kümmere mich um Loeg!"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "あっ！？",
      "source_en": "Ah!?",
      "text": "Ah?!"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "おっ――",
      "source_en": "Oh...",
      "text": "Oh …"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "おお――",
      "source_en": "Oh...",
      "text": "Oh …"
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_en",
      "source_jp": "はっ！",
      "source_en": "Hah!",
      "text": "Ha!"
    },
    {
      "key": "",
      "read_index": "15",
      "tag_source": "source_en",
      "source_jp": "うわっ！！",
      "source_en": "Wow!!",
      "text": "Woah!"
    },
    {
      "key": "",
      "read_index": "16",
      "tag_source": "source_en",
      "source_jp": "ぐっ―",
      "source_en": "Guh―",
      "text": "Uff …"
    },
    {
      "key": "",
      "read_index": "17",
      "tag_source": "source_en",
      "source_jp": "あっ―",
      "source_en": "Ah-",
      "text": "Ah …"
    },
    {
