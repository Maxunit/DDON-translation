{
  "gmd_path": "ui\\00_message\\event\\st0134\\ev010.gmd",
  "arc_path": "\\event\\st0134\\st0134ev010.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "やった！",
      "source_en": "Got it!",
      "text": "Geschafft!"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "うわっ！！（リアクションボイス）",
      "source_en": "Whoa!! (reacting)",
      "text": "Ah! (erschrickt)"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "エリオット！",
      "source_en": "Elliot!",
      "text": "Elliot!"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "んっ――うっ――（リアクションボイス）",
      "source_en": "Nuuh— (Pained groans)",
      "text": "Nngh … Uff … (stöhnt)"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "俺はいいから\r\n早くネド王子のところ――",
      "source_en": "It's fine with me.\r\nLet's go to meet Prince Nedo right away.",
      "text": "Kümmert euch nicht um mich.\r\nIhr müsst schnell zu Prinz Nedo …"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "放ってはおけない",
      "source_en": "Can't just leave it.",
      "text": "Wir lassen dich doch nicht einfach hier."
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "俺はね、こういう時が来たら潔く諦めようと\r\n常々思っていたんだ",
      "source_en": "I, uh... I always thought that when a time like\r\nthis comes, I should surrender gracefully.",
      "text": "Ich dachte immer, wenn’s mal so weit ist,\r\nfinde ich mich damit ab."
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "そういうの、似合わないよ",
      "source_en": "That doesn't suit you.",
      "text": "Das passt überhaupt nicht zu dir."
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "――あはは――厳しいね",
      "source_en": "Ahaha, it's tough, isn't it?",
      "text": "Ha … gar nicht so leicht, oder?"
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "隊長、エリオットは私たちが運ぶから",
      "source_en": "Captain, we'll carry Elliot.",
      "text": "Hauptmann, wir tragen Elliot."
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "ああ、隊長は俺たちの後ろを頼むぜ",
      "source_en": "Yeah, the captain's got our backs.",
      "text": "Ja, Hauptmann, du hältst uns den Rücken frei."
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
