{
  "gmd_path": "ui\\00_message\\quest\\q90000111.gmd",
  "arc_path": "\\quest\\q90000111.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "油断するな",
      "source_en": "Don't let your guard down.",
      "text": "Bleib wachsam."
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "悪くない――その調子だ",
      "source_en": "Not bad -- that's the way.",
      "text": "Nicht schlecht. Weiter so."
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "目の前の敵に集中するんだ",
      "source_en": "Focus on the enemy in front of you.",
      "text": "Konzentrier dich auf den Gegner vor dir."
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "切り込むぞ！",
      "source_en": "Let's cut them down!",
      "text": "Jetzt greifen wir an!"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "よし、ここは制圧した",
      "source_en": "Okay, we're in control here.",
      "text": "Gut, dieser Abschnitt ist gesichert."
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "それで良い、次に向かうぞ！",
      "source_en": "Excellent, let's move on!",
      "text": "Sehr gut. Weiter zum nächsten!"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "新手の敵だ、注意しろ！",
      "source_en": "It's a new enemy, beware!",
      "text": "Verstärkung für den Feind! Pass auf!"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "今こそ名をあげる時だ――",
      "source_en": "Now is the time to make a name for yourself--",
      "text": "Jetzt kannst du dir einen Namen machen …"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "相変わらずの臭いだな",
      "source_en": "The stench is still the same as always.",
      "text": "Der Gestank ist ganz der alte."
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "今日こそ決着を付けてくれる！",
      "source_en": "Today is the day to settle this!",
      "text": "Heute klären wir ein für alle Mal, wer stärker ist!"
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "逃がしたか――",
      "source_en": "Did they escape?",
      "text": "Er ist entkommen …"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "覚者の命、全て狩り取ってくれるわ",
      "source_en": "I will take the lives of all Arisen.",
      "text": "Ich jage euch alle, bis kein Erweckter mehr übrig ist!"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "覚者の命は値千金！　奪え！",
      "source_en": "The life of an Arisen is invaluable! Seize it!",
      "text": "Erweckte bringen ein Vermögen! Holt sie euch!"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "今日はここまでだ",
      "source_en": "This day shall be your last!",
      "text": "Für heute reicht’s."
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_en",
      "source_jp": "まさか――この――俺が――",
      "source_en": "I can't believe... that I...",
      "text": "Das kann nicht sein … Ich …"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
