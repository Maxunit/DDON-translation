{
  "gmd_path": "ui\\00_message\\event\\st0404\\ev005.gmd",
  "arc_path": "\\event\\st0404\\st0404ev005.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "――覚者さんたち、やるね",
      "source_en": "...Arisen, you've done well.",
      "text": "Ihr Erweckten habt’s wirklich drauf …"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "もう、メイリーフは\r\n――任せるよ",
      "source_en": "Mayleaf's protection...\r\nI'll leave it to you.",
      "text": "Mayleaf …\r\nIch vertraue sie euch an."
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "ひとつ、頼みがある――",
      "source_en": "I have... one request...",
      "text": "Ich habe noch eine Bitte …"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "まもなく尽きる――",
      "source_en": "I'm running out of time...",
      "text": "Es geht zu Ende …"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "僕の命――",
      "source_en": "My life...",
      "text": "Mein Leben …"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "あの器に入れて――\r\n白竜に捧げて欲しい――",
      "source_en": "Please put it in that vessel...\r\nDedicate it to the White Dragon...",
      "text": "Schließt es in dieses Gefäß ein …\r\nBringt es dem Weißen Drachen dar …"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "きっときみたちの――",
      "source_en": "I'm sure it'll...",
      "text": "Ich bin sicher, es kann …"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "役に立つはず――",
      "source_en": "Be useful to you all...",
      "text": "… euch noch nützen …"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "ああ――",
      "source_en": "Ah...",
      "text": "Ah …"
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "看取られて死ねるなんて――",
      "source_en": "Passing on with someone by your side...",
      "text": "Dass jemand in meiner letzten Stunde bei mir ist …"
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "考えたこともなかった――",
      "source_en": "I had never even thought about it...",
      "text": "Daran hätte ich nie gedacht …"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "これはいただくぞ！",
      "source_en": "I'll gladly accept this!",
      "text": "Das nehme ich gern!"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "（高笑い）",
      "source_en": "(High laughter)",
      "text": "(Lautes Lachen)"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
