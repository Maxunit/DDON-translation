    {
      "key": "hud_pawn_ann_lost",
      "read_index": "21",
      "source_jp": "<VAL> がポーン郷にある異界の狭間へ送られました",
      "source_en": "<VAL> was sent to the Rift within Pawn Cathedral",
      "text": "<VAL> wurde in den Rift der Vasallenkathedrale geschickt."
    },
    {
      "key": "hud_pawn_ann_rescue_start",
      "read_index": "22",
      "source_jp": "<VAL> を襲いかかる敵から救出せよ",
      "source_en": "Rescue <VAL> from the attacking enemies",
      "text": "Rette <VAL> vor den angreifenden Gegnern."
    },
    {
      "key": "hud_pawn_ann_rescue_failed",
      "read_index": "23",
      "source_jp": "<VAL> の呪縛を解くことができなかった",
      "source_en": "I was unable to break the curse of <VAL>",
      "text": "Der Fluch von <VAL> konnte nicht gebrochen werden."
    },
    {
      "key": "hud_pawn_ann_rescue_clear",
      "read_index": "24",
      "source_jp": "<VAL> の呪縛が解け、リムの淵辺で目を覚ました",
      "source_en": "The curse of <VAL> was lifted, and I woke up at\r\nthe Depths of the Rift, eyes open.",
      "text": "Der Fluch von <VAL> ist gebrochen.\r\nDer Vasall erwacht am Rand des Rifts."
    },
    {
      "key": "hud_pawn_ann_resurrection",
      "read_index": "25",
      "source_jp": "<VAL> が復活し、待機状態に戻りました",
      "source_en": "<VAL> rescued and returned to standby",
      "text": "<VAL> wurde gerettet und steht wieder bereit."
