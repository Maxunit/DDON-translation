{
  "gmd_path": "ui\\00_message\\event\\st0411\\ev005.gmd",
  "arc_path": "\\event\\st0411\\st0411ev005.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "気に入らなかった――",
      "source_en": "I didn't like it at all...",
      "text": "Das hat mir überhaupt nicht gefallen …"
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "寂しかった――",
      "source_en": "I was so lonely...",
      "text": "Ich war so einsam …"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "わたしがいなくても――",
      "source_en": "Even when I'm gone...",
      "text": "Wenn ich nicht mehr da bin …"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "世界は変わらない",
      "source_en": "The world won't change.",
      "text": "… bleibt die Welt, wie sie ist."
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "レオは",
      "source_en": "Leo won't...",
      "text": "Und Leo …"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "変わらない",
      "source_en": "Change.",
      "text": "… bleibt, wie er ist."
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "禊の神殿の誓いで――\r\n俺は変わった",
      "source_en": "With the oath at the Temple of Purification...\r\nI did change.",
      "text": "Als wir im Tempel der Läuterung unseren Eid geleistet haben,\r\nhat mich das verändert."
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "おまえが変わらずに過ごしているのが\r\n理解できず――",
      "source_en": "I couldn't understand\r\nhow you were still the same...!",
      "text": "Ich habe einfach nicht verstanden,\r\nwie du so bleiben konntest, wie du warst …"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "だから",
      "source_en": "If that is so...",
      "text": "Und deshalb …"
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "変わるしかなかった",
      "source_en": "I had no choice but to change.",
      "text": "… musste ich mich ändern."
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "なんだ――",
      "source_en": "Is that so...?",
      "text": "Ach, so war das …"
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "すれ違いかぁ",
      "source_en": "So we passed each other by...",
      "text": "Wir haben aneinander vorbeigelebt."
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "――ディアマンテスってのは",
      "source_en": "Diamantes...",
      "text": "Dieser Diamantes …"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "どんな野郎だろうな？",
      "source_en": "What kind of bastard is he?",
      "text": "Was ist der für ein Mistkerl?"
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_en",
      "source_jp": "イリスをこの世界から\r\n引き離すなんて――",
      "source_en": "To pull Iris from this world...",
      "text": "Iris aus dieser Welt zu reißen …"
    },
    {
      "key": "",
      "read_index": "15",
      "tag_source": "source_en",
      "source_jp": "顔を見ておかないと",
      "source_en": "I need to see his face.",
      "text": "Ich muss sein Gesicht sehen."
    },
    {
      "key": "",
      "read_index": "16",
      "tag_source": "source_en",
      "source_jp": "気が済まん",
      "source_en": "I won't be satisfied otherwise.",
      "text": "Sonst finde ich keine Ruhe."
    },
    {
      "key": "",
      "read_index": "17",
      "tag_source": "source_en",
      "source_jp": "（咳）",
      "source_en": "(Cough)",
      "text": "(Husten)"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
