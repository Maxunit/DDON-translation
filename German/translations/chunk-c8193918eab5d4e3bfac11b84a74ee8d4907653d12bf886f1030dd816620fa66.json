{
  "gmd_path": "ui\\00_message\\quest\\q90000113.gmd",
  "arc_path": "\\quest\\q90000113.arc",
  "entries": [
    {
      "key": "",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "気を抜くなよ",
      "source_en": "Don't let your guard down.",
      "text": "Lass nicht nach."
    },
    {
      "key": "",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "良い動きだ！",
      "source_en": "Good move!",
      "text": "Gut reagiert!"
    },
    {
      "key": "",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "落ち着いて仕留めるんだ！",
      "source_en": "Stay calm and finish them off!",
      "text": "Bleib ruhig und bring es zu Ende!"
    },
    {
      "key": "",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "さあ！全ての敵を切り倒せ！",
      "source_en": "Okay! Cut down every enemy!",
      "text": "Los! Lass keinen Gegner übrig!"
    },
    {
      "key": "",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "この調子で駆け抜けるぞ！",
      "source_en": "Push through at this pace!",
      "text": "Weiter so, wir müssen hier durch!"
    },
    {
      "key": "",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "よくやった、付いてこい！",
      "source_en": "Well done, follow me!",
      "text": "Gut gemacht. Folge mir!"
    },
    {
      "key": "",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "新手の敵だ、突撃するぞ！",
      "source_en": "It's a new enemy. We're going to charge them!",
      "text": "Neue Gegner. Auf sie!"
    },
    {
      "key": "",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "来たぞ、集中しろ！",
      "source_en": "Here they come, concentrate!",
      "text": "Da sind sie. Konzentrier dich!"
    },
    {
      "key": "",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "ほう――大将のお出ましだ",
      "source_en": "Ho—the general is here",
      "text": "Sieh an … Da kommt der Anführer."
    },
    {
      "key": "",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "こいつは手強いな",
      "source_en": "This one is tough.",
      "text": "Der ist zäh."
    },
    {
      "key": "",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "逃げ足の速い奴だ",
      "source_en": "They're fast on their feet.",
      "text": "Der kann aber schnell die Beine in die Hand nehmen."
    },
    {
      "key": "",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "おっとっと",
      "source_en": "Oops!",
      "text": "Hoppala!"
    },
    {
      "key": "",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "敵の動きをよく見るんだ――",
      "source_en": "Watch your enemy's movements--",
      "text": "Beobachte, wie sich der Gegner bewegt …"
    },
    {
      "key": "",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "無理するなよ――",
      "source_en": "Don't push yourself too hard...",
      "text": "Übernimm dich nicht …"
    },
    {
      "key": "",
      "read_index": "14",
      "tag_source": "source_en",
      "source_jp": "さーて、どうなることやら",
      "source_en": "Well, let's see what happens.",
      "text": "Na, mal sehen, wie das ausgeht."
    },
    {
      "key": "",
      "read_index": "15",
      "tag_source": "source_en",
      "source_jp": "怪我はないか？",
      "source_en": "Are you hurt?",
      "text": "Bist du verletzt?"
    },
    {
      "key": "",
      "read_index": "16",
      "tag_source": "source_en",
      "source_jp": "上出来だね",
      "source_en": "Well done.",
      "text": "Gut gemacht."
    },
    {
      "key": "",
      "read_index": "17",
      "tag_source": "source_en",
      "source_jp": "なるようにしかならんか",
      "source_en": "It can't be helped.",
      "text": "Es kommt, wie es kommt."
    },
    {
      "key": "",
      "read_index": "18",
      "tag_source": "source_en",
      "source_jp": "ここは覚悟の決め時か――",
      "source_en": "This is the time to decide――",
      "text": "Jetzt gibt es kein Zurück mehr …"
    },
    {
      "key": "",
      "read_index": "19",
      "tag_source": "source_en",
      "source_jp": "まだおわりって訳じゃぁないだろう？",
      "source_en": "It's not the end yet, is it?",
      "text": "Das war’s doch noch nicht, oder?"
    },
    {
      "key": "",
      "read_index": "20",
      "tag_source": "source_en",
      "source_jp": "なかなかやるじゃないか",
      "source_en": "You've got some skills.",
      "text": "Du hast ja einiges drauf."
    },
    {
      "key": "",
      "read_index": "21",
      "tag_source": "source_en",
      "source_jp": "よくやった、深追いする必要はない――",
      "source_en": "Well done, there's no need to press further――",
      "text": "Gut gemacht. Lass sie laufen …"
    },
    {
      "key": "",
      "read_index": "22",
      "tag_source": "source_en",
      "source_jp": "覚者の命、全て狩り取ってくれるわ",
      "source_en": "I will take the lives of all Arisen.",
      "text": "Ich jage euch alle, bis kein Erweckter mehr übrig ist!"
    },
    {
      "key": "",
      "read_index": "23",
      "tag_source": "source_en",
      "source_jp": "会いに来てやったぞ、金色の戦士よ",
      "source_en": "I have come to meet you, golden warrior.",
      "text": "Ich bin gekommen, um dich zu sehen, goldener Krieger."
    },
    {
      "key": "",
      "read_index": "24",
      "tag_source": "source_en",
      "source_jp": "覚者の命は値千金！　奪え！",
      "source_en": "The life of an Arisen is invaluable! Seize it!",
      "text": "Erweckte bringen ein Vermögen! Holt sie euch!"
    },
    {
      "key": "",
      "read_index": "25",
      "tag_source": "source_en",
      "source_jp": "楽しませてくれる",
      "source_en": "You're providing some entertainment.",
      "text": "Du machst mir Spaß."
    },
    {
      "key": "",
      "read_index": "26",
      "tag_source": "source_en",
      "source_jp": "今日はここまでだ",
      "source_en": "This day shall be your last!",
      "text": "Für heute reicht’s."
    },
    {
      "key": "",
      "read_index": "27",
      "tag_source": "source_en",
      "source_jp": "次を心待ちにしているぞ",
      "source_en": "I'm looking forward to the next one.",
      "text": "Ich freue mich schon aufs nächste Mal."
    },
    {
      "key": "",
      "read_index": "28",
      "tag_source": "source_en",
      "source_jp": "まさか――この――俺が――",
      "source_en": "I can't believe... that I...",
      "text": "Das kann nicht sein … Ich …"
    },
    {
      "key": "",
      "read_index": "29",
      "tag_source": "source_en",
      "source_jp": "存分に楽しませてもらったぞ――",
      "source_en": "I've thoroughly enjoyed myself――",
      "text": "Ich hatte mein Vergnügen …"
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
