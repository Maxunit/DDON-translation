{
  "gmd_path": "ui\\00_message\\event\\st0411\\ev000.gmd",
  "arc_path": "\\event\\st0411\\st0411ev000.arc",
  "entries": [
    {
      "key": "",
      "read_index": "45",
      "tag_source": "source_en",
      "source_jp": "――俺の弱味をつくことだ",
      "source_en": "To exploit my weakness?",
      "text": "Er will meine Schwäche ausnutzen."
    },
    {
      "key": "",
      "read_index": "46",
      "tag_source": "source_en",
      "source_jp": "だから",
      "source_en": "If that is so...",
      "text": "Und deshalb …"
    },
    {
      "key": "",
      "read_index": "47",
      "tag_source": "source_en",
      "source_jp": "屈するわけにはいかない",
      "source_en": "I cannot yield.",
      "text": "… darf ich nicht nachgeben."
    },
    {
      "key": "",
      "read_index": "48",
      "tag_source": "source_en",
      "source_jp": "認めるわけにはいかない",
      "source_en": "I cannot accept it.",
      "text": "Ich darf das nicht hinnehmen."
    },
    {
      "key": "",
      "read_index": "49",
      "tag_source": "source_en",
      "source_jp": "強くあれ――",
      "source_en": "To be strong...",
      "text": "Stark bleiben …"
    },
    {
      "key": "",
      "read_index": "50",
      "tag_source": "source_en",
      "source_jp": "それがミシアルの遺志だ",
      "source_en": "That is Mysial's will.",
      "text": "Das war Mysials letzter Wille."
    },
    {
      "key": "",
      "read_index": "51",
      "tag_source": "source_en",
      "source_jp": "自意識、強すぎないかな？",
      "source_en": "A bit full of yourself,  aren't you?",
      "text": "Nimmst du dich da nicht ein bisschen zu wichtig?"
    },
    {
      "key": "",
      "read_index": "52",
      "tag_source": "source_en",
      "source_jp": "悪いか",
      "source_en": "Is it wrong?",
      "text": "Ist das so schlimm?"
    },
    {
      "key": "",
      "read_index": "53",
      "tag_source": "source_en",
      "source_jp": "（息遣い）",
      "source_en": "(Breathing)",
      "text": "(Atemgeräusch)"
    },
    {
      "key": "",
      "read_index": "54",
      "tag_source": "source_en",
      "source_jp": "（息遣い）",
      "source_en": "(Breathing)",
      "text": "(Atemgeräusch)"
    }
  ],
