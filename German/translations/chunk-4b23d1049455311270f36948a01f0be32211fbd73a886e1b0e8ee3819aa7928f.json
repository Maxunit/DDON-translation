{
  "gmd_path": "ui\\00_message\\ui\\pawn_feedback_comment.gmd",
  "arc_path": "\\ui\\menu_cmn.arc",
  "entries": [
    {
      "key": "pawn_fb_01_001",
      "read_index": "3",
      "tag_source": "source_en",
      "source_jp": "コーディネートが素敵だ！",
      "source_en": "Lovely coordination!",
      "text": "Schöne Koordination!"
    },
    {
      "key": "pawn_fb_01_002",
      "read_index": "4",
      "tag_source": "source_en",
      "source_jp": "アバンギャルドだ！",
      "source_en": "Avant-garde!",
      "text": "Avantgarde!"
    },
    {
      "key": "pawn_fb_01_003",
      "read_index": "5",
      "tag_source": "source_en",
      "source_jp": "クールだ！",
      "source_en": "Cool!",
      "text": "Cool!"
    },
    {
      "key": "pawn_fb_01_004",
      "read_index": "6",
      "tag_source": "source_en",
      "source_jp": "配色がいいね！",
      "source_en": "Nice color scheme!",
      "text": "Schönes Farbschema!"
    },
    {
      "key": "pawn_fb_01_005",
      "read_index": "7",
      "tag_source": "source_en",
      "source_jp": "憧れる装備だ！",
      "source_en": "Yearns for the equipment!",
      "text": "Sehnsucht nach der Ausrüstung!"
    },
    {
      "key": "pawn_fb_01_006",
      "read_index": "8",
      "tag_source": "source_en",
      "source_jp": "自分のポーンよりいいね！",
      "source_en": "Better than one's pawn!",
      "text": "Besser als der eigene Vasall!"
    },
    {
      "key": "pawn_fb_01_007",
      "read_index": "9",
      "tag_source": "source_en",
      "source_jp": "可愛いね！",
      "source_en": "Cute!",
      "text": "Niedlich!"
    },
    {
      "key": "pawn_fb_01_008",
      "read_index": "10",
      "tag_source": "source_en",
      "source_jp": "カッコイイね！",
      "source_en": "Cool huh!",
      "text": "Cool huh!"
    },
    {
      "key": "pawn_fb_01_009",
      "read_index": "11",
      "tag_source": "source_en",
      "source_jp": "自分のポーンと同じくらいの見栄えだ",
      "source_en": "About the same appearance as one's pawn",
      "text": "Über das gleiche Aussehen wie jemandes Vasall"
    },
    {
      "key": "pawn_fb_01_010",
      "read_index": "12",
      "tag_source": "source_en",
      "source_jp": "なかなか素敵な着合わせだ",
      "source_en": "Quite nice set of clothes",
      "text": "Ziemlich schöne Kleidung"
    },
    {
      "key": "pawn_fb_01_011",
      "read_index": "13",
      "tag_source": "source_en",
      "source_jp": "良いコーディネートじゃないか",
      "source_en": "Good coordination isn't it?",
      "text": "Gute Koordination, nicht wahr?"
    },
    {
      "key": "pawn_fb_01_012",
      "read_index": "14",
      "tag_source": "source_en",
      "source_jp": "外見はいまいちかな・・・",
      "source_en": "Appearance is somewhat lacking I wonder...",
      "text": "Das Aussehen fehlt etwas, ich frage mich..."
    },
    {
      "key": "pawn_fb_01_013",
      "read_index": "15",
      "tag_source": "source_en",
      "source_jp": "オシャレにも気を使おうぜ",
      "source_en": "To be fashionable, use care!",
      "text": "Um modisch zu sein, verwende Pflege!"
    },
    {
      "key": "pawn_fb_01_014",
      "read_index": "16",
      "tag_source": "source_en",
      "source_jp": "ダサいぜ・・・",
      "source_en": "So passé...",
      "text": "Passé..."
    },
    {
      "key": "pawn_fb_01_015",
      "read_index": "17",
      "tag_source": "source_en",
      "source_jp": "そのセンスは理解不能だ",
      "source_en": "That sense is impossible to understand",
      "text": "Dieser Sinn ist unmöglich zu verstehen"
    },
    {
      "key": "pawn_fb_01_016",
      "read_index": "18",
      "tag_source": "source_en",
      "source_jp": "すごい色だ・・",
      "source_en": "Terrible color..",
      "text": "Schreckliche Farbe."
    },
    {
      "key": "pawn_fb_01_comment",
      "read_index": "0",
      "tag_source": "source_en",
      "source_jp": "<VAL>さんにレンタルされた",
      "source_en": "<VAL> rented the pawn.",
      "text": "<VAL> mietete den Vasallen."
    },
    {
      "key": "pawn_fb_02_001",
      "read_index": "19",
      "tag_source": "source_en",
      "source_jp": "君が居なかったらダメだった",
      "source_en": "Without you, it would be hopeless",
      "text": "Ohne dich wäre es hoffnungslos"
    },
    {
      "key": "pawn_fb_02_002",
      "read_index": "20",
      "tag_source": "source_en",
      "source_jp": "強すぎる！",
      "source_en": "Too strong!",
      "text": "Zu stark!"
    },
    {
      "key": "pawn_fb_02_003",
      "read_index": "21",
      "tag_source": "source_en",
      "source_jp": "その強さになるにはどのくらいかかるんだ",
      "source_en": "How long does it take to become that strong?",
      "text": "Wie lange dauert es, so stark zu werden?"
    },
    {
      "key": "pawn_fb_02_004",
      "read_index": "22",
      "tag_source": "source_en",
      "source_jp": "良い働きだった！",
      "source_en": "It was good work!",
      "text": "Es war eine gute Arbeit!"
    },
    {
      "key": "pawn_fb_02_005",
      "read_index": "23",
      "tag_source": "source_en",
      "source_jp": "何度も助けられた",
      "source_en": "Was helped many times",
      "text": "Es wurde viele Male geholfen"
    },
    {
      "key": "pawn_fb_02_006",
      "read_index": "24",
      "tag_source": "source_en",
      "source_jp": "いいアシストだったよ",
      "source_en": "It was a good assist!",
      "text": "Es war eine gute Hilfe!"
    },
    {
      "key": "pawn_fb_02_007",
      "read_index": "25",
      "tag_source": "source_en",
      "source_jp": "期待通りだった",
      "source_en": "Met my expectations",
      "text": "Erfüllt meine Erwartungen"
    },
    {
      "key": "pawn_fb_02_008",
      "read_index": "26",
      "tag_source": "source_en",
      "source_jp": "守ってくれてありがとう",
      "source_en": "Thank you for giving me protection",
      "text": "Danke, dass du mir Schutz gegeben hast"
    },
    {
      "key": "pawn_fb_02_009",
      "read_index": "27",
      "tag_source": "source_en",
      "source_jp": "助けになった",
      "source_en": "Helped me out",
      "text": "Hilf mir heraus"
    },
    {
      "key": "pawn_fb_02_010",
      "read_index": "28",
      "tag_source": "source_en",
      "source_jp": "まぁまぁの働きぶりだった",
      "source_en": "It was a so-so kind of work",
      "text": "Es war eine so-so Art von Arbeit"
    },
    {
      "key": "pawn_fb_02_011",
      "read_index": "29",
      "tag_source": "source_en",
      "source_jp": "次はもう少しいい働きを期待している",
      "source_en": "The next in line are expecting a bit better work",
      "text": "Die nächsten in der Reihe erwarten ein bisschen bessere Arbeit"
    },
    {
      "key": "pawn_fb_02_012",
      "read_index": "30",
      "tag_source": "source_en",
      "source_jp": "まだまだ強くなってほしい",
      "source_en": "Not enough, I want you to become stronger",
      "text": "Nicht genug, ich möchte, dass du stärker wirst"
    },
    {
      "key": "pawn_fb_02_013",
      "read_index": "31",
      "tag_source": "source_en",
      "source_jp": "精進あるのみだ",
      "source_en": "Nothing but devotion",
      "text": "Nichts als Hingabe"
    },
    {
      "key": "pawn_fb_02_014",
      "read_index": "32",
      "tag_source": "source_en",
      "source_jp": "弱かったぞ・・・",
      "source_en": "Was so weak...",
      "text": "War so schwach..."
    },
    {
      "key": "pawn_fb_02_015",
      "read_index": "33",
      "tag_source": "source_en",
      "source_jp": "助けることが多かった・・・",
      "source_en": "Something to rescue many times...",
      "text": "Etwas, das man viele Male retten kann..."
    },
    {
      "key": "pawn_fb_02_016",
      "read_index": "34",
      "tag_source": "source_en",
      "source_jp": "役に立たなかった・・・",
      "source_en": "Was useless...",
      "text": "Es war nutzlos..."
    },
    {
      "key": "pawn_fb_02_comment",
      "read_index": "1",
      "tag_source": "source_en",
      "source_jp": "<VAL>さんと一緒に冒険した",
      "source_en": "<VAL> went on an adventure with the pawn.",
      "text": "<VAL> ging auf ein Abenteuer mit dem Vasallen."
    },
    {
      "key": "pawn_fb_03_001",
      "read_index": "35",
      "tag_source": "source_en",
      "source_jp": "いいものができた！",
      "source_en": "Something good came out!",
      "text": "Etwas Gutes kam heraus!"
    },
    {
      "key": "pawn_fb_03_002",
      "read_index": "36",
      "tag_source": "source_en",
      "source_jp": "おかげでいいアイテムが作れたよ！",
      "source_en": "Thanks to you, a nice item was made!",
      "text": "Dank dir wurde ein schöner Artikel gemacht!"
    },
    {
      "key": "pawn_fb_03_003",
      "read_index": "37",
      "tag_source": "source_en",
      "source_jp": "着実にやってくれた！",
      "source_en": "It turned out solid!",
      "text": "Es stellte sich als solide heraus!"
    },
    {
      "key": "pawn_fb_03_004",
      "read_index": "38",
      "tag_source": "source_en",
      "source_jp": "いいクラフト能力だ！",
      "source_en": "Good crafting ability!",
      "text": "Gute Handwerkskunst!"
    },
    {
      "key": "pawn_fb_03_005",
      "read_index": "39",
      "tag_source": "source_en",
      "source_jp": "ナイスな働きだった！",
      "source_en": "Nice work was done!",
      "text": "Schöne Arbeit wurde geleistet!"
    },
    {
      "key": "pawn_fb_03_006",
      "read_index": "40",
      "tag_source": "source_en",
      "source_jp": "いいアシストだった！",
      "source_en": "It was a good assist!",
      "text": "Es war eine gute Hilfe!"
    },
    {
      "key": "pawn_fb_03_007",
      "read_index": "41",
      "tag_source": "source_en",
      "source_jp": "十分に働いてくれた",
      "source_en": "Sufficiently worked for me",
      "text": "Ausreichend für mich gearbeitet"
    },
    {
      "key": "pawn_fb_03_008",
      "read_index": "42",
      "tag_source": "source_en",
      "source_jp": "期待通りだった",
      "source_en": "Met my expectations",
      "text": "Erfüllt meine Erwartungen"
    },
    {
      "key": "pawn_fb_03_009",
      "read_index": "43",
      "tag_source": "source_en",
      "source_jp": "悪くない能力だ",
      "source_en": "Not bad ability",
      "text": "Keine schlechte Fähigkeit"
    },
    {
      "key": "pawn_fb_03_010",
      "read_index": "44",
      "tag_source": "source_en",
      "source_jp": "次もよろしく頼む",
      "source_en": "Give my regards to the next in line also",
      "text": "Grüße auch die nächste in der Reihe"
    },
    {
      "key": "pawn_fb_03_011",
      "read_index": "45",
      "tag_source": "source_en",
      "source_jp": "クラフトの性能はまだまだだな・・・",
      "source_en": "Crafting performance still needs work...",
      "text": "Crafting Performance braucht noch Arbeit..."
    },
    {
      "key": "pawn_fb_03_012",
      "read_index": "46",
      "tag_source": "source_en",
      "source_jp": "次はもう少しいい働きを期待している",
      "source_en": "The next in line are expecting a bit better work",
      "text": "Die nächsten in der Reihe erwarten ein bisschen bessere Arbeit"
    },
    {
      "key": "pawn_fb_03_013",
      "read_index": "47",
      "tag_source": "source_en",
      "source_jp": "精進あるのみだ",
      "source_en": "Nothing but devotion",
      "text": "Nichts als Hingabe"
    },
    {
      "key": "pawn_fb_03_014",
      "read_index": "48",
      "tag_source": "source_en",
      "source_jp": "能力がまだまだ低い・・・",
      "source_en": "The ability has a long way to go from being low...",
      "text": "Die Fähigkeit hat einen langen Weg zu gehen von niedrig..."
    },
    {
      "key": "pawn_fb_03_015",
      "read_index": "49",
      "tag_source": "source_en",
      "source_jp": "経験がたりないな",
      "source_en": "Not enough experience",
      "text": "Nicht genug Erfahrung"
    },
    {
      "key": "pawn_fb_03_016",
      "read_index": "50",
      "tag_source": "source_en",
      "source_jp": "がんばってね",
      "source_en": "Do your best, OK?",
      "text": "Mach dein Bestes, okay?"
    },
    {
      "key": "pawn_fb_03_comment",
      "read_index": "2",
      "tag_source": "source_en",
      "source_jp": "<VAL>さんのポーンと協力してクラフトをがんばった",
      "source_en": "<VAL> crafted with the pawn.",
      "text": "<VAL> mit dem Vasallen gemacht."
    }
  ],
  "schema_version": 1,
  "scope": "DDON Chunk Manager"
}
